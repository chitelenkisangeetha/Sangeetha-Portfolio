debar_default_recent_room_row_count\":3,\"typing_indicator_timeout_s\":10,\"sidebar_pagination_page_size\":6,\"outdated_room_bootstrap_messages_count\":10,\"idle_room_navigation_timeout_s\":900,\"max_file_size_mb\":5,\"max_pinned_room_count\":2},\"is_device_based\":false,\"passed\":false},\"1368094425\":{\"name\":\"1368094425\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"stableID\",\"value\":{},\"is_device_based\":true,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1299917208\":{\"name\":\"1299917208\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"stableID\",\"value\":{\"handoff_link_strategy\":\"legacy_root\"},\"is_device_based\":true,\"passed\":false},\"3934129380\":{\"name\":\"3934129380\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"id_type\":\"userID\",\"value\":{\"model\":\"gpt-4o\"},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"enable_web_search\":false,\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"3652260651\":{\"name\":\"3652260651\",\"rule_id\":\"6aZqU0DBwDUxrKwIsbsUU0:100.00:5-6aZqTYYz4lL38kYMR3xhAY\",\"secondary_exposures\":[],\"version\":54,\"id_type\":\"userID\",\"value\":{\"connection_tone\":\"connected-2026-05-r2.wav\",\"thinking_tone\":\"thinking-2026-05-r2.wav\",\"error_tone\":\"error-2025-11-19.wav\",\"hangup_tone\":\"hangup_2026_04_09.ogg\"},\"is_device_based\":false,\"passed\":true},\"1947723669\":{\"name\":\"1947723669\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[{\"gate\":\"1128318992\",\"gateValue\":\"true\",\"ruleID\":\"6nfCdMnXGSRG9PC5PYuxX1:100.00:6\"}],\"version\":100,\"id_type\":\"stableID\",\"value\":{\"custom_banner_variant\":\"modal\"},\"is_device_based\":true,\"group_name\":\"Modal\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"247832287\":{\"name\":\"247832287\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"payment_method_order\":[]},\"is_device_based\":false,\"passed\":false},\"111706139\":{\"name\":\"111706139\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"444232970\",\"gateValue\":\"false\",\"ruleID\":\"gbNhJYZt2LT0MMPpBwPnn\"}],\"version\":19,\"id_type\":\"userID\",\"value\":{\"tempDisabled\":false,\"enabled\":true,
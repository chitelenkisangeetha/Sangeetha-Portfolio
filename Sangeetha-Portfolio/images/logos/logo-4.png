4,\"_306\":109,\"_307\":1685,\"_309\":1686,\"_311\":312,\"_313\":34,\"_314\":1687,\"_316\":317,\"_318\":1688,\"_320\":1688,\"_321\":109,\"_66\":67,\"_322\":34,\"_323\":1674,\"_324\":10},{\"_50\":334,\"_335\":1691},[],[],[],{\"_325\":1689},[],\"d025ca76-e897-4df8-ba83-827446e4dd94\",\"a5818093-8741-4016-bd85-718052197e91\",{\"_273\":1690,\"_330\":14,\"_331\":14,\"_332\":-5},\"tx60hz\",[337],[1693],\"Yes ra — now I understand exactly what you want. You **don't want a white/light corporate template**. You want a **dark, premium creative-freelancer website** with controlled bright colors, stronger visual sections, and more personality.\\n\\nLet's completely change the theme.\\n\\n**Theme:** Dark charcoal + electric blue + violet + subtle cyan  \\n**Feel:** Creative agency / digital marketer / designer  \\n**Not:** plain white, dull beige, or overly neon.\\n\\nAgain: `css/style.css` → **Ctrl + A → Delete → paste this entire code**.\\n\\n```css id=\\\"73164\\\"\\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700\u0026family=Manrope:wght@600;700;800\u0026display=swap');\\n\\n:root {\\n    --bg: #0b0f19;\\n    --bg-soft: #101624;\\n    --card: #141b2b;\\n    --card-light: #192235;\\n    --white: #ffffff;\\n    --text: #e7ebf3;\\n    --muted: #98a3b7;\\n    --blue: #4f8cff;\\n    --blue-dark: #2d68df;\\n    --cyan: #4dd9ff;\\n    --purple: #8b6cff;\\n    --border: rgba(255, 255, 255, 0.09);\\n    --max-width: 1180px;\\n    --radius: 18px;\\n    --shadow: 0 20px 50px rgba(0, 0, 0, 0.28);\\n}\\n\\n/* GLOBAL */\\n\\n* {\\n    margin: 0;\\n    padding: 0;\\n    box-sizing: border-box;\\n}\\n\\nhtml {\\n    scroll-behavior: smooth;\\n}\\n\\nbody {\\n    font-family: 'DM Sans', sans-serif;\\n    background: var(--bg);\\n    color: var(--text);\\n    line-height: 1.6;\\n    overflow-x: hidden;\\n}\\n\\nbody::before {\\n    content: \\\"\\\";\\n    position: fixed;\\n    width: 500px;\\n    height: 500px;\\n    background: rgba(79, 140, 255, 0.08);\\n    border-radius: 50%;\\n    filter: blur(100px);\\n    top: -200px;\\n    left: -200px;\\n    pointer-events: none;\\n    z-index: -1;\\n}\\n\\nbody::after {\\n    content: \\\"\\\";\\n    position: fixed;\\n    width: 450px;\\n    height: 450px;\\n    background: rgba(139, 108, 255, 0.06);\\n    border-radius: 50%;\\n    filter: blur(100px);\\n    bottom: -200px;\\n    right: -150px;\\n    pointer-events: none;\\n    z-index: -1;\\n}\\n\\nimg,\\nvideo {\\n    max-width: 100%;\\n    display: block;\\n}\\n\\na {\\n    color: inherit;\\n    text-decoration: none;\\n}\\n\\nbutton {\\n    font-family: inherit;\\n}\\n\\n/* NAVBAR */\\n\\n.navbar {\\n    width: calc(100% - 50px);\\n    max-width: var(--max-width);\\n    margin: 20px auto 0;\\n    padding: 12px 15px;\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    gap: 25px;\\n    background: rgba(17, 23, 37, 0.88);\\n    border: 1px solid var(--border);\\n    border-radius: 16px;\\n    backdrop-filter: blur(18px);\\n    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.2);\\n    position: relative;\\n    z-index: 10;\\n}\\n\\n.logo {\\n    display: flex;\\n    align-items: center;\\n    padding-left: 7px;\\n}\\n\\n.logo img {\\n    width: 70px;\\n    height: auto;\\n}\\n\\n.nav-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 3px;\\n    padding: 4px;\\n    background: rgba(255, 255, 255, 0.045);\\n    border-radius: 10px;\\n}\\n\\n.nav-links a {\\n    padding: 9px 14px;\\n    color: #aeb7c8;\\n    font-size: 13px;\\n    font-weight: 500;\\n    border-radius: 7px;\\n    transition: 0.3s ease;\\n}\\n\\n.nav-links a:hover {\\n    color: white;\\n    background: rgba(255, 255, 255, 0.08);\\n}\\n\\n.nav-links a:first-child {\\n    color: white;\\n    background: rgba(79, 140, 255, 0.16);\\n}\\n\\n.nav-button {\\n    padding: 10px 18px;\\n    background: linear-gradient(135deg, var(--blue), var(--purple));\\n    color: white;\\n    border-radius: 9px;\\n    font-size: 12px;\\n    font-weight: 600;\\n    white-space: nowrap;\\n    box-shadow: 0 7px 20px rgba(79, 140, 255, 0.2);\\n    transition: 0.3s ease;\\n}\\n\\n.nav-button:hover {\\n    transform: translateY(-2px);\\n    box-shadow: 0 10px 25px rgba(79, 140, 255, 0.3);\\n}\\n\\n/* HERO */\\n\\n.hero {\\n    max-width: var(--max-width);\\n    min-height: 690px;\\n    margin: auto;\\n    padding: 80px 25px;\\n    display: grid;\\n    grid-template-columns: 1.1fr 0.9fr;\\n    align-items: center;\\n    gap: 70px;\\n    position: relative;\\n}\\n\\n.hero-content {\\n    position: relative;\\n    z-index: 2;\\n}\\n\\n.hero-small-text {\\n    display: inline-flex;\\n    padding: 7px 13px;\\n    border: 1px solid rgba(79, 140, 255, 0.3);\\n    background: rgba(79, 140, 255, 0.08);\\n    color: #8eb3ff;\\n    border-radius: 30px;\\n    font-size: 11px;\\n    font-weight: 600;\\n    letter-spacing: 1px;\\n}\\n\\n.hero h1 {\\n    margin-top: 22px;\\n    font-family: 'Manrope', sans-serif;\\n    color: white;\\n    font-size: clamp(48px, 6vw, 76px);\\n    line-height: 1.05;\\n    font-weight: 800;\\n    letter-spacing: -3px;\\n}\\n\\n.hero h1::after {\\n    content: \\\"\\\";\\n    display: block;\\n    width: 90px;\\n    height: 4px;\\n    margin-top: 20px;\\n    border-radius: 10px;\\n    background: linear-gradient(90deg, var(--blue), var(--cyan));\\n}\\n\\n.hero-description {\\n    max-width: 570px;\\n    margin-top: 25px;\\n    color: var(--muted);\\n    font-size: 16px;\\n    line-height: 1.8;\\n}\\n\\n.hero-buttons {\\n    margin-top: 34px;\\n    display: flex;\\n    align-items: center;\\n    gap: 12px;\\n    flex-wrap: wrap;\\n}\\n\\n.primary-button,\\n.secondary-button {\\n    display: inline-flex;\\n    align-items: center;\\n    justify-content: center;\\n    padding: 13px 22px;\\n    border-radius: 9px;\\n    font-size: 13px;\\n    font-weight: 600;\\n    transition: 0.3s ease;\\n}\\n\\n.primary-button {\\n    background: linear-gradient(135deg, var(--blue), var(--purple));\\n    color: white;\\n    box-shadow: 0 10px 25px rgba(79, 140, 255, 0.2);\\n}\\n\\n.primary-button:hover {\\n    transform: translateY(-3px);\\n    box-shadow: 0 15px 30px rgba(79, 140, 255, 0.3);\\n}\\n\\n.secondary-button {\\n    border: 1px solid var(--border);\\n    background: rgba(255, 255, 255, 0.04);\\n    color: #dce3ef;\\n}\\n\\n.secondary-button:hover {\\n    border-color: var(--blue);\\n    color: white;\\n}\\n\\n/* HERO VISUAL */\\n\\n.hero-visual {\\n    display: flex;\\n    justify-content: center;\\n    position: relative;\\n}\\n\\n.hero-visual::before {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 330px;\\n    height: 330px;\\n    border-radius: 50%;\\n    background: rgba(79, 140, 255, 0.12);\\n    filter: blur(50px);\\n}\\n\\n.hero-card {\\n    width: 100%;\\n    max-width: 390px;\\n    min-height: 480px;\\n    padding: 40px;\\n    border: 1px solid rgba(255, 255, 255, 0.1);\\n    border-radius: 25px;\\n    background:\\n        linear-gradient(145deg, rgba(79, 140, 255, 0.12), rgba(139, 108, 255, 0.06)),\\n        #121a2a;\\n    color: white;\\n    display: flex;\\n    flex-direction: column;\\n    justify-content: flex-end;\\n    position: relative;\\n    overflow: hidden;\\n    box-shadow: var(--shadow);\\n    z-index: 2;\\n}\\n\\n.hero-card::before {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 230px;\\n    height: 230px;\\n    border-radius: 50%;\\n    background: linear-gradient(135deg, rgba(79, 140, 255, 0.35), rgba(77, 217, 255, 0.12));\\n    top: -80px;\\n    right: -70px;\\n}\\n\\n.hero-card::after {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 160px;\\n    height: 160px;\\n    border: 1px solid rgba(255, 255, 255, 0.12);\\n    border-radius: 50%;\\n    top: 50px;\\n    right: 45px;\\n}\\n\\n.hero-card p {\\n    position: relative;\\n    z-index: 2;\\n    color: var(--cyan);\\n    font-size: 11px;\\n    letter-spacing: 3px;\\n    font-weight: 700;\\n}\\n\\n.hero-card h2 {\\n    position: relative;\\n    z-index: 2;\\n    margin-top: 13px;\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 47px;\\n    line-height: 1.05;\\n}\\n\\n.hero-card span {\\n    position: relative;\\n    z-index: 2;\\n    margin-top: 25px;\\n    color: #aeb9cb;\\n    font-size: 12px;\\n}\\n\\n/* SECTION */\\n\\n.section {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    padding: 110px 25px;\\n}\\n\\n.section-heading {\\n    max-width: 720px;\\n    margin-bottom: 55px;\\n}\\n\\n.section-label {\\n    color: var(--cyan);\\n    font-size: 11px;\\n    font-weight: 700;\\n    letter-spacing: 2px;\\n}\\n\\n.section-heading h2 {\\n    margin-top: 10px;\\n    font-family: 'Manrope', sans-serif;\\n    color: white;\\n    font-size: clamp(36px, 5vw, 52px);\\n    line-height: 1.1;\\n    letter-spacing: -1.8px;\\n}\\n\\n.section-heading \u003e p:last-child {\\n    margin-top: 15px;\\n    color: var(--muted);\\n}\\n\\n/* ABOUT */\\n\\n.about-content {\\n    display: grid;\\n    grid-template-columns: 1fr 1fr;\\n    gap: 65px;\\n    align-items: start;\\n}\\n\\n.about-text {\\n    display: flex;\\n    flex-direction: column;\\n    gap: 19px;\\n}\\n\\n.about-text p {\\n    color: #a7b1c1;\\n    font-size: 15px;\\n    line-height: 1.9;\\n}\\n\\n.about-highlights {\\n    display: grid;\\n    gap: 15px;\\n}\\n\\n.highlight-card {\\n    padding: 27px;\\n    background: linear-gradient(145deg, #141d2e, #111827);\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    transition: 0.3s ease;\\n}\\n\\n.highlight-card:hover {\\n    transform: translateY(-4px);\\n    border-color: rgba(79, 140, 255, 0.35);\\n    box-shadow: var(--shadow);\\n}\\n\\n.highlight-card h3 {\\n    color: white;\\n    font-size: 18px;\\n}\\n\\n.highlight-card p {\\n    margin-top: 7px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n/* SERVICES */\\n\\n.services {\\n    max-width: none;\\n    padding-left: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    padding-right: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    background: #0f1522;\\n    border-top: 1px solid var(--border);\\n    border-bottom: 1px solid var(--border);\\n}\\n\\n.services-grid {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: 18px;\\n}\\n\\n.service-card {\\n    min-height: 245px;\\n    padding: 28px;\\n    background: linear-gradient(145deg, #161f31, #111827);\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    position: relative;\\n    overflow: hidden;\\n    transition: 0.3s ease;\\n}\\n\\n.service-card::before {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 70px;\\n    height: 70px;\\n    border-radius: 50%;\\n    background: rgba(79, 140, 255, 0.1);\\n    right: -25px;\\n    top: -25px;\\n}\\n\\n.service-card:hover {\\n    transform: translateY(-6px);\\n    border-color: rgba(79, 140, 255, 0.4);\\n    box-shadow: var(--shadow);\\n}\\n\\n.service-number {\\n    color: var(--cyan);\\n    font-size: 12px;\\n    font-weight: 700;\\n}\\n\\n.service-card h3 {\\n    margin-top: 48px;\\n    color: white;\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 19px;\\n}\\n\\n.service-card p {\\n    margin-top: 9px;\\n    color: var(--muted);\\n    font-size: 13px;\\n    line-height: 1.7;\\n}\\n\\n/* PORTFOLIO */\\n\\n.portfolio-filters {\\n    display: flex;\\n    gap: 9px;\\n    flex-wrap: wrap;\\n    margin-bottom: 55px;\\n}\\n\\n.filter-button {\\n    padding: 9px 18px;\\n    border: 1px solid var(--border);\\n    border-radius: 8px;\\n    background: #121927;\\n    color: #aeb7c8;\\n    cursor: pointer;\\n    font-size: 12px;\\n    font-weight: 500;\\n    transition: 0.3s ease;\\n}\\n\\n.filter-button:hover,\\n.filter-button.active {\\n    background: var(--blue);\\n    color: white;\\n    border-color: var(--blue);\\n    box-shadow: 0 7px 18px rgba(79, 140, 255, 0.18);\\n}\\n\\n.portfolio-category {\\n    margin-bottom: 90px;\\n}\\n\\n.category-heading {\\n    margin-bottom: 25px;\\n}\\n\\n.category-heading h3 {\\n    color: white;\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 28px;\\n}\\n\\n.category-heading p {\\n    margin-top: 5px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n.portfolio-grid {\\n    display: grid;\\n    gap: 20px;\\n}\\n\\n.logo-grid,\\n.poster-grid {\\n    grid-template-columns: repeat(3, 1fr);\\n}\\n\\n.portfolio-card {\\n    background: #121927;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    overflow: hidden;\\n    transition: 0.3s ease;\\n}\\n\\n.portfolio-card:hover {\\n    transform: translateY(-6px);\\n    border-color: rgba(79, 140, 255, 0.3);\\n    box-shadow: var(--shadow);\\n}\\n\\n.portfolio-image {\\n    width: 100%;\\n    aspect-ratio: 1 / 1;\\n    background: #1a2232;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n.portfolio-image img {\\n    width: 100%;\\n    height: 100%;\\n    object-fit: contain;\\n}\\n\\n.portfolio-info {\\n    padding: 19px 20px;\\n}\\n\\n.portfolio-info h4 {\\n    color: white;\\n    font-size: 15px;\\n    font-weight: 600;\\n}\\n\\n.portfolio-info p {\\n    margin-top: 3px;\\n    color: var(--muted);\\n    font-size: 12px;\\n}\\n\\n/* VIDEOS */\\n\\n.video-grid {\\n    grid-template-columns: repeat(3, minmax(0, 1fr));\\n    align-items: start;\\n}\\n\\n.video-container {\\n    width: 100%;\\n    background: #080c14;\\n    display: flex;\\n    justify-content: center;\\n}\\n\\n.video-container video {\\n    width: 100%;\\n    height: auto;\\n    max-height: 650px;\\n    object-fit: contain;\\n}\\n\\n/* META ADS */\\n\\n.meta-ads-container {\\n    display: grid;\\n    grid-template-columns: repeat(2, minmax(0, 1fr));\\n    gap: 22px;\\n}\\n\\n.report-image {\\n    width: 100%;\\n    background: #171f2e;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n.report-image img {\\n    width: 100%;\\n    height: auto;\\n    object-fit: contain;\\n}\\n\\n/* SEO */\\n\\n.coming-soon {\\n    min-height: 220px;\\n    border: 1px dashed #3b4659;\\n    border-radius: var(--radius);\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    justify-content: center;\\n    text-align: center;\\n    background: #121927;\\n}\\n\\n.coming-soon span {\\n    padding: 8px 18px;\\n    border-radius: 7px;\\n    background: rgba(79, 140, 255, 0.12);\\n    color: #8eb3ff;\\n    font-size: 11px;\\n    font-weight: 700;\\n}\\n\\n.coming-soon p {\\n    margin-top: 11px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n/* WHY ME */\\n\\n.why-me {\\n    max-width: none;\\n    background:\\n        radial-gradient(circle at 15% 30%, rgba(79, 140, 255, 0.1), transparent 30%),\\n        radial-gradient(circle at 85% 70%, rgba(139, 108, 255, 0.1), transparent 30%),\\n        #101725;\\n    color: white;\\n    padding-left: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    padding-right: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    border-top: 1px solid var(--border);\\n    border-bottom: 1px solid var(--border);\\n}\\n\\n.why-me .section-heading {\\n    max-width: var(--max-width);\\n    margin-left: auto;\\n    margin-right: auto;\\n}\\n\\n.why-me-grid {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: 18px;\\n}\\n\\n.why-card {\\n    padding: 29px;\\n    background: rgba(255, 255, 255, 0.035);\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    transition: 0.3s ease;\\n}\\n\\n.why-card:hover {\\n    transform: translateY(-4px);\\n    background: rgba(79, 140, 255, 0.07);\\n    border-color: rgba(79, 140, 255, 0.3);\\n}\\n\\n.why-card h3 {\\n    color: white;\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 18px;\\n}\\n\\n.why-card p {\\n    margin-top: 10px;\\n    color: #9ca8bb;\\n    font-size: 13px;\\n    line-height: 1.7;\\n}\\n\\n/* CONTACT */\\n\\n.contact {\\n    text-align: center;\\n    padding-top: 125px;\\n    padding-bottom: 125px;\\n    position: relative;\\n}\\n\\n.contact-content {\\n    max-width: 800px;\\n    margin: auto;\\n}\\n\\n.contact h2 {\\n    margin-top: 13px;\\n    font-family: 'Manrope', sans-serif;\\n    color: white;\\n    font-size: clamp(40px, 6vw, 62px);\\n    line-height: 1.1;\\n    letter-spacing: -2px;\\n}\\n\\n.contact-content \u003e p:not(.section-label) {\\n    max-width: 600px;\\n    margin: 19px auto 0;\\n    color: var(--muted);\\n}\\n\\n.contact-buttons {\\n    justify-content: center;\\n}\\n\\n/* FOOTER */\\n\\n.footer {\\n    background: #080c14;\\n    color: white;\\n    padding: 50px 25px 22px;\\n    border-top: 1px solid var(--border);\\n}\\n\\n.footer-content {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: flex;\\n    justify-content: space-between;\\n    gap: 40px;\\n}\\n\\n.footer-brand h3 {\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 22px;\\n}\\n\\n.footer-brand p {\\n    margin-top: 5px;\\n    color: #7f8ba0;\\n    font-size: 12px;\\n}\\n\\n.footer-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 24px;\\n    flex-wrap: wrap;\\n}\\n\\n.footer-links a {\\n    color: #8f9bad;\\n    font-size: 12px;\\n    transition: 0.3s ease;\\n}\\n\\n.footer-links a:hover {\\n    color: var(--cyan);\\n}\\n\\n.footer-bottom {\\n    max-width: var(--max-width);\\n    margin: 35px auto 0;\\n    padding-top: 18px;\\n    border-top: 1px solid rgba(255, 255, 255, 0.07);\\n}\\n\\n.footer-bottom p {\\n    color: #596579;\\n    font-size: 11px;\\n}\\n\\n.portfolio-card.hidden {\\n    display: none;\\n}\\n\\n/* TABLET */\\n\\n@media (max-width: 900px) {\\n\\n    .navbar {\\n        width: calc(100% - 30px);\\n        flex-wrap: wrap;\\n    }\\n\\n    .nav-links {\\n        order: 3;\\n        width: 100%;\\n        justify-content: center;\\n    }\\n\\n    .hero {\\n        grid-template-columns: 1fr;\\n        padding-top: 60px;\\n    }\\n\\n    .hero-visual {\\n        justify-content: flex-start;\\n    }\\n\\n    .about-content {\\n        grid-template-columns: 1fr;\\n        gap: 45px;\\n    }\\n\\n    .services-grid,\\n    .why-me-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n\\n    .logo-grid,\\n    .poster-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n\\n    .video-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n}\\n\\n/* MOBILE */\\n\\n@media (max-width: 600px) {\\n\\n    .navbar {\\n        width: calc(100% - 20px);\\n        margin-top: 10px;\\n        padding: 10px;\\n    }\\n\\n    .logo {\\n        padding-left: 4px;\\n    }\\n\\n    .logo img {\\n        width: 60px;\\n    }\\n\\n    .nav-button {\\n        display: none;\\n    }\\n\\n    .nav-links {\\n        width: 100%;\\n        justify-content: flex-start;\\n        gap: 3px;\\n        overflow-x: auto;\\n    }\\n\\n    .nav-links a {\\n        padding: 8px 12px;\\n        font-size: 11px;\\n        white-space: nowrap;\\n    }\\n\\n    .hero {\\n        min-height: auto;\\n        padding: 60px 20px 80px;\\n        gap: 45px;\\n    }\\n\\n    .hero h1 {\\n        font-size: 45px;\\n        letter-spacing: -1.5px;\\n    }\\n\\n    .hero-description {\\n        font-size: 14px;\\n    }\\n\\n    .hero-card {\\n        min-height: 380px;\\n        padding: 32px;\\n    }\\n\\n    .hero-card h2 {\\n        font-size: 40px;\\n    }\\n\\n    .section {\\n        padding: 85px 20px;\\n    }\\n\\n    .section-heading {\\n        margin-bottom: 40px;\\n    }\\n\\n    .section-heading h2 {\\n        font-size: 37px;\\n    }\\n\\n    .services {\\n        padding-left: 20px;\\n        padding-right: 20px;\\n    }\\n\\n    .services-grid,\\n    .why-me-grid,\\n    .logo-grid,\\n    .poster-grid,\\n    .video-grid,\\n    .meta-ads-container {\\n        grid-template-columns: 1fr;\\n    }\\n\\n    .service-card {\\n        min-height: auto;\\n    }\\n\\n    .service-card h3 {\\n        margin-top: 32px;\\n    }\\n\\n    .portfolio-category {\\n        margin-bottom: 65px;\\n    }\\n\\n    .portfolio-filters {\\n        gap: 7px;\\n    }\\n\\n    .filter-button {\\n        padding: 8px 13px;\\n        font-size: 11px;\\n    }\\n\\n    .footer-content {\\n        flex-direction: column;\\n    }\\n\\n    .footer-links {\\n        gap: 15px;\\n    }\\n\\n    .contact {\\n        padding-top: 90px;\\n        padding-bottom: 90px;\\n    }\\n}\\n```\\n\\n### Ee design lo em change ayyindi?\\n\\n**Navbar:** dark glass-style, blue active tab, blue-purple CTA.\\n\\n**Hero:** dark background + glowing blue/cyan accents + stronger typography.\\n\\n**Services:** separate dark section with cards that stand out.\\n\\n**My Work:** your actual designs/videos will stand out because the background is dark.\\n\\n**Why Work With Me:** dark premium section with subtle blue/purple glow.\\n\\n**Contact:** dark background instead of plain white.\\n\\n**Colors:**  \\n🔵 Electric blue  \\n🟣 Controlled purple  \\n🔷 Subtle cyan  \\n⚫ Deep navy/charcoal  \\n\\nSo overall **creative freelancer + digital marketing agency** type feel vastundi, but still professional—not childish/neon.\",{},{\"_273\":1674,\"_280\":1698,\"_54\":1699,\"_56\":1699,\"_284\":1700,\"_286\":287,\"_289\":290,\"_291\":1701,\"_293\":294},\"035c3180-56be-440d-a312-de9a1f11505f\",[1661],{\"_343\":356,\"_291\":1703},1790859462.491967,{\"_338\":339,\"_340\":1702},{\"_353\":34,\"_306\":109,\"_311\":312,\"_314\":1687,\"_316\":317,\"_318\":1688,\"_320\":1688,\"_321\":109,\"_66\":67,\"_323\":1696,\"_324\":10,\"_322\":14},[355],{},{\"_273\":1696,\"_280\":1707,\"_54\":1708,\"_56\":1709,\"_284\":1710,\"_286\":287,\"_289\":290,\"_291\":1711,\"_293\":294},\"fb580a5d-aa77-4c2c-b6f4-9a3a80efd1b3\",[1674],{\"_343\":373,\"_291\":1717},1790859450.37,1790859497.258185,{\"_338\":339,\"_340\":1716},{\"_366\":1712,\"_456\":34,\"_457\":1713,\"_459\":1714,\"_461\":462,\"_314\":1687,\"_368\":-5,\"_318\":1688,\"_320\":1688,\"_463\":14,\"_324\":10,\"_322\":14},{\"_369\":1715},\"You given complete background white and the icons also white. I didn't like this. You have to give some dark theme and brightful colors, which is professional. You given very simple text. Can you please give again once again CSS code completely different from this?\",\"sediment://file_000000008bf4821197adff3fda5fa1d2\",[],[1713],{},{\"_273\":1705,\"_280\":1721,\"_54\":1722,\"_56\":1723,\"_284\":1724,\"_286\":287,\"_288\":34,\"_289\":290,\"_291\":1725,\"_293\":294,\"_295\":296},\"ba6379b1-43da-4660-bac4-ae57d5ae623b\",[1696],{\"_343\":344,\"_291\":1739},1790859354.191985,1790859403.023619,{\"_338\":339,\"_340\":1737},{\"_297\":1726,\"_299\":34,\"_300\":1727,\"_302\":1728,\"_304\":1729,\"_306\":109,\"_307\":1730,\"_309\":1731,\"_311\":312,\"_313\":34,\"_314\":1732,\"_316\":317,\"_318\":1733,\"_320\":1733,\"_321\":109,\"_66\":67,\"_322\":34,\"_323\":1719,\"_324\":10},{\"_50\":334,\"_335\":1736},[],[],[],{\"_325\":1734},[],\"40200842-d7a3-4031-a4c2-3a04ca522d64\",\"2a9c7204-17d3-4ca0-9169-07414cd0ad36\",{\"_273\":1735,\"_330\":14,\"_331\":14,\"_332\":-5},\"42887t\",[337],[1738],\"Yes ra ❤️ confusion avvakunda **full `style.css` code one shot** istanu.\\n\\n👉 `css/style.css` open cheyyi → **Ctrl + A** → old code motham delete → **kindha code motham paste** → `Ctrl + S`.\\n\\nThis version has a **professional medium-tone blue + navy look**, and the navbar is cleaner and more premium.\\n\\n```css\\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700\u0026family=Manrope:wght@600;700;800\u0026display=swap');\\n\\n:root {\\n    --bg: #f5f7fa;\\n    --white: #ffffff;\\n    --surface: #edf1f6;\\n    --text: #344054;\\n    --heading: #101828;\\n    --muted: #667085;\\n    --accent: #356ae6;\\n    --accent-dark: #2454c7;\\n    --accent-light: #eaf0ff;\\n    --navy: #172033;\\n    --border: #dfe4ec;\\n    --shadow: 0 10px 30px rgba(16, 24, 40, 0.06);\\n    --radius: 16px;\\n    --max-width: 1180px;\\n}\\n\\n* {\\n    margin: 0;\\n    padding: 0;\\n    box-sizing: border-box;\\n}\\n\\nhtml {\\n    scroll-behavior: smooth;\\n}\\n\\nbody {\\n    font-family: 'DM Sans', sans-serif;\\n    background: var(--bg);\\n    color: var(--text);\\n    line-height: 1.6;\\n}\\n\\nimg,\\nvideo {\\n    max-width: 100%;\\n    display: block;\\n}\\n\\na {\\n    color: inherit;\\n    text-decoration: none;\\n}\\n\\nbutton {\\n    font-family: inherit;\\n}\\n\\n/* NAVBAR */\\n\\n.navbar {\\n    width: calc(100% - 40px);\\n    max-width: var(--max-width);\\n    margin: 18px auto 0;\\n    padding: 12px 14px;\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    gap: 25px;\\n    background: rgba(255, 255, 255, 0.96);\\n    border: 1px solid var(--border);\\n    border-radius: 14px;\\n    box-shadow: 0 5px 22px rgba(16, 24, 40, 0.05);\\n}\\n\\n.logo {\\n    display: flex;\\n    align-items: center;\\n    padding-left: 8px;\\n}\\n\\n.logo img {\\n    width: 68px;\\n    height: auto;\\n}\\n\\n.nav-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 4px;\\n    padding: 4px;\\n    background: #f1f4f8;\\n    border-radius: 10px;\\n}\\n\\n.nav-links a {\\n    padding: 9px 15px;\\n    color: #526071;\\n    font-size: 13px;\\n    font-weight: 500;\\n    border-radius: 7px;\\n    transition: 0.3s ease;\\n}\\n\\n.nav-links a:hover {\\n    color: var(--accent);\\n    background: white;\\n}\\n\\n.nav-links a:first-child {\\n    color: var(--accent);\\n    background: white;\\n    box-shadow: 0 2px 7px rgba(16, 24, 40, 0.06);\\n}\\n\\n.nav-button {\\n    display: inline-flex;\\n    align-items: center;\\n    justify-content: center;\\n    padding: 10px 18px;\\n    background: var(--accent);\\n    color: white;\\n    border-radius: 8px;\\n    font-size: 12px;\\n    font-weight: 600;\\n    white-space: nowrap;\\n    transition: 0.3s ease;\\n}\\n\\n.nav-button:hover {\\n    background: var(--accent-dark);\\n    transform: translateY(-1px);\\n}\\n\\n/* HERO */\\n\\n.hero {\\n    max-width: var(--max-width);\\n    min-height: 650px;\\n    margin: auto;\\n    padding: 75px 25px;\\n    display: grid;\\n    grid-template-columns: 1.1fr 0.9fr;\\n    align-items: center;\\n    gap: 70px;\\n}\\n\\n.hero-small-text,\\n.section-label {\\n    color: var(--accent);\\n    font-size: 12px;\\n    font-weight: 700;\\n    letter-spacing: 1.8px;\\n}\\n\\n.hero h1 {\\n    margin-top: 14px;\\n    font-family: 'Manrope', sans-serif;\\n    color: var(--heading);\\n    font-size: clamp(48px, 6vw, 72px);\\n    line-height: 1.08;\\n    font-weight: 800;\\n    letter-spacing: -2.5px;\\n}\\n\\n.hero-description {\\n    max-width: 570px;\\n    margin-top: 25px;\\n    color: var(--muted);\\n    font-size: 16px;\\n    line-height: 1.8;\\n}\\n\\n.hero-buttons,\\n.contact-buttons {\\n    margin-top: 32px;\\n    display: flex;\\n    align-items: center;\\n    gap: 12px;\\n    flex-wrap: wrap;\\n}\\n\\n.primary-button,\\n.secondary-button {\\n    display: inline-flex;\\n    align-items: center;\\n    justify-content: center;\\n    padding: 13px 22px;\\n    border-radius: 8px;\\n    font-size: 13px;\\n    font-weight: 600;\\n    transition: 0.3s ease;\\n}\\n\\n.primary-button {\\n    background: var(--accent);\\n    color: white;\\n}\\n\\n.primary-button:hover {\\n    background: var(--accent-dark);\\n    transform: translateY(-2px);\\n}\\n\\n.secondary-button {\\n    background: white;\\n    color: var(--text);\\n    border: 1px solid var(--border);\\n}\\n\\n.secondary-button:hover {\\n    border-color: var(--accent);\\n    color: var(--accent);\\n}\\n\\n.hero-visual {\\n    display: flex;\\n    justify-content: center;\\n}\\n\\n.hero-card {\\n    width: 100%;\\n    max-width: 390px;\\n    min-height: 450px;\\n    padding: 42px;\\n    border-radius: 22px;\\n    background: linear-gradient(145deg, #293955, #172033);\\n    color: white;\\n    display: flex;\\n    flex-direction: column;\\n    justify-content: flex-end;\\n    position: relative;\\n    overflow: hidden;\\n    box-shadow: 0 25px 55px rgba(23, 32, 51, 0.18);\\n}\\n\\n.hero-card::before {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 220px;\\n    height: 220px;\\n    border-radius: 50%;\\n    background: rgba(53, 106, 230, 0.25);\\n    top: -70px;\\n    right: -60px;\\n}\\n\\n.hero-card::after {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 140px;\\n    height: 140px;\\n    border: 1px solid rgba(255, 255, 255, 0.15);\\n    border-radius: 50%;\\n    top: 60px;\\n    right: 45px;\\n}\\n\\n.hero-card p,\\n.hero-card h2,\\n.hero-card span {\\n    position: relative;\\n    z-index: 2;\\n}\\n\\n.hero-card p {\\n    color: #a9bcff;\\n    font-size: 11px;\\n    letter-spacing: 3px;\\n    font-weight: 700;\\n}\\n\\n.hero-card h2 {\\n    margin-top: 12px;\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 46px;\\n    line-height: 1.08;\\n}\\n\\n.hero-card span {\\n    margin-top: 25px;\\n    color: #cbd5e1;\\n    font-size: 12px;\\n}\\n\\n/* COMMON SECTIONS */\\n\\n.section {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    padding: 105px 25px;\\n}\\n\\n.section-heading {\\n    max-width: 700px;\\n    margin-bottom: 50px;\\n}\\n\\n.section-heading h2 {\\n    margin-top: 10px;\\n    font-family: 'Manrope', sans-serif;\\n    color: var(--heading);\\n    font-size: clamp(36px, 5vw, 52px);\\n    line-height: 1.12;\\n    letter-spacing: -1.5px;\\n}\\n\\n.section-heading \u003e p:last-child {\\n    margin-top: 14px;\\n    color: var(--muted);\\n}\\n\\n/* ABOUT */\\n\\n.about-content {\\n    display: grid;\\n    grid-template-columns: 1fr 1fr;\\n    gap: 65px;\\n    align-items: start;\\n}\\n\\n.about-text {\\n    display: flex;\\n    flex-direction: column;\\n    gap: 18px;\\n}\\n\\n.about-text p {\\n    color: #536174;\\n    font-size: 15px;\\n    line-height: 1.9;\\n}\\n\\n.about-highlights {\\n    display: grid;\\n    gap: 14px;\\n}\\n\\n.highlight-card {\\n    padding: 26px;\\n    background: white;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    box-shadow: 0 5px 20px rgba(16, 24, 40, 0.03);\\n    transition: 0.3s ease;\\n}\\n\\n.highlight-card:hover {\\n    transform: translateY(-3px);\\n    box-shadow: var(--shadow);\\n}\\n\\n.highlight-card h3 {\\n    color: var(--heading);\\n    font-size: 18px;\\n}\\n\\n.highlight-card p {\\n    margin-top: 7px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n/* SERVICES */\\n\\n.services {\\n    max-width: none;\\n    padding-left: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    padding-right: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    background: #e9edf3;\\n}\\n\\n.services-grid {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: 18px;\\n}\\n\\n.service-card {\\n    min-height: 235px;\\n    padding: 28px;\\n    background: white;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    transition: 0.3s ease;\\n}\\n\\n.service-card:hover {\\n    transform: translateY(-5px);\\n    border-color: #b9c9ee;\\n    box-shadow: var(--shadow);\\n}\\n\\n.service-number {\\n    color: var(--accent);\\n    font-size: 12px;\\n    font-weight: 700;\\n}\\n\\n.service-card h3 {\\n    margin-top: 48px;\\n    color: var(--heading);\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 19px;\\n}\\n\\n.service-card p {\\n    margin-top: 9px;\\n    color: var(--muted);\\n    font-size: 13px;\\n    line-height: 1.7;\\n}\\n\\n/* PORTFOLIO */\\n\\n.portfolio-filters {\\n    display: flex;\\n    gap: 9px;\\n    flex-wrap: wrap;\\n    margin-bottom: 50px;\\n}\\n\\n.filter-button {\\n    padding: 9px 18px;\\n    border: 1px solid var(--border);\\n    border-radius: 8px;\\n    background: white;\\n    color: #475467;\\n    cursor: pointer;\\n    font-size: 12px;\\n    font-weight: 500;\\n    transition: 0.3s ease;\\n}\\n\\n.filter-button:hover,\\n.filter-button.active {\\n    background: var(--accent);\\n    color: white;\\n    border-color: var(--accent);\\n}\\n\\n.portfolio-category {\\n    margin-bottom: 85px;\\n}\\n\\n.category-heading {\\n    margin-bottom: 23px;\\n}\\n\\n.category-heading h3 {\\n    color: var(--heading);\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 27px;\\n}\\n\\n.category-heading p {\\n    margin-top: 5px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n.portfolio-grid {\\n    display: grid;\\n    gap: 20px;\\n}\\n\\n.logo-grid,\\n.poster-grid {\\n    grid-template-columns: repeat(3, 1fr);\\n}\\n\\n.portfolio-card {\\n    background: white;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    overflow: hidden;\\n    transition: 0.3s ease;\\n}\\n\\n.portfolio-card:hover {\\n    transform: translateY(-5px);\\n    box-shadow: var(--shadow);\\n}\\n\\n.portfolio-image {\\n    width: 100%;\\n    aspect-ratio: 1 / 1;\\n    background: #edf0f4;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n.portfolio-image img {\\n    width: 100%;\\n    height: 100%;\\n    object-fit: contain;\\n}\\n\\n.portfolio-info {\\n    padding: 18px 20px;\\n}\\n\\n.portfolio-info h4 {\\n    color: var(--heading);\\n    font-size: 15px;\\n    font-weight: 600;\\n}\\n\\n.portfolio-info p {\\n    margin-top: 3px;\\n    color: var(--muted);\\n    font-size: 12px;\\n}\\n\\n/* VIDEOS */\\n\\n.video-grid {\\n    grid-template-columns: repeat(3, minmax(0, 1fr));\\n    align-items: start;\\n}\\n\\n.video-container {\\n    width: 100%;\\n    background: #111827;\\n    display: flex;\\n    justify-content: center;\\n}\\n\\n.video-container video {\\n    width: 100%;\\n    height: auto;\\n    max-height: 650px;\\n    object-fit: contain;\\n}\\n\\n/* META ADS */\\n\\n.meta-ads-container {\\n    display: grid;\\n    grid-template-columns: repeat(2, minmax(0, 1fr));\\n    gap: 22px;\\n}\\n\\n.report-image {\\n    width: 100%;\\n    background: #edf0f4;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n.report-image img {\\n    width: 100%;\\n    height: auto;\\n    object-fit: contain;\\n}\\n\\n/* SEO */\\n\\n.coming-soon {\\n    min-height: 210px;\\n    border: 1px dashed #bfc7d4;\\n    border-radius: var(--radius);\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    justify-content: center;\\n    text-align: center;\\n    background: white;\\n}\\n\\n.coming-soon span {\\n    padding: 8px 17px;\\n    border-radius: 7px;\\n    background: var(--accent-light);\\n    color: var(--accent-dark);\\n    font-size: 11px;\\n    font-weight: 700;\\n}\\n\\n.coming-soon p {\\n    margin-top: 10px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n/* WHY ME */\\n\\n.why-me {\\n    max-width: none;\\n    background: var(--navy);\\n    color: white;\\n    padding-left: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    padding-right: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n}\\n\\n.why-me .section-heading {\\n    max-width: var(--max-width);\\n    margin-left: auto;\\n    margin-right: auto;\\n}\\n\\n.why-me .section-heading h2 {\\n    color: white;\\n}\\n\\n.why-me .section-label {\\n    color: #9db4ff;\\n}\\n\\n.why-me-grid {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: 18px;\\n}\\n\\n.why-card {\\n    padding: 28px;\\n    border: 1px solid #303b51;\\n    border-radius: var(--radius);\\n    background: rgba(255, 255, 255, 0.025);\\n    transition: 0.3s ease;\\n}\\n\\n.why-card:hover {\\n    background: rgba(255, 255, 255, 0.05);\\n    border-color: #45536e;\\n}\\n\\n.why-card h3 {\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 18px;\\n}\\n\\n.why-card p {\\n    margin-top: 10px;\\n    color: #aeb8c9;\\n    font-size: 13px;\\n    line-height: 1.7;\\n}\\n\\n/* CONTACT */\\n\\n.contact {\\n    text-align: center;\\n    padding-top: 120px;\\n    padding-bottom: 120px;\\n}\\n\\n.contact-content {\\n    max-width: 800px;\\n    margin: auto;\\n}\\n\\n.contact h2 {\\n    margin-top: 12px;\\n    font-family: 'Manrope', sans-serif;\\n    color: var(--heading);\\n    font-size: clamp(38px, 6vw, 60px);\\n    line-height: 1.12;\\n    letter-spacing: -1.5px;\\n}\\n\\n.contact-content \u003e p:not(.section-label) {\\n    max-width: 600px;\\n    margin: 18px auto 0;\\n    color: var(--muted);\\n}\\n\\n.contact-buttons {\\n    justify-content: center;\\n}\\n\\n/* FOOTER */\\n\\n.footer {\\n    background: #101828;\\n    color: white;\\n    padding: 48px 25px 22px;\\n}\\n\\n.footer-content {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: flex;\\n    justify-content: space-between;\\n    gap: 40px;\\n}\\n\\n.footer-brand h3 {\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 22px;\\n}\\n\\n.footer-brand p {\\n    margin-top: 4px;\\n    color: #98a2b3;\\n    font-size: 12px;\\n}\\n\\n.footer-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 24px;\\n    flex-wrap: wrap;\\n}\\n\\n.footer-links a {\\n    color: #b5bfce;\\n    font-size: 12px;\\n    transition: 0.3s ease;\\n}\\n\\n.footer-links a:hover {\\n    color: white;\\n}\\n\\n.footer-bottom {\\n    max-width: var(--max-width);\\n    margin: 35px auto 0;\\n    padding-top: 18px;\\n    border-top: 1px solid #263247;\\n}\\n\\n.footer-bottom p {\\n    color: #667085;\\n    font-size: 11px;\\n}\\n\\n.portfolio-card.hidden {\\n    display: none;\\n}\\n\\n/* TABLET */\\n\\n@media (max-width: 900px) {\\n\\n    .navbar {\\n        width: calc(100% - 30px);\\n        flex-wrap: wrap;\\n    }\\n\\n    .nav-links {\\n        order: 3;\\n        width: 100%;\\n        justify-content: center;\\n    }\\n\\n    .hero {\\n        grid-template-columns: 1fr;\\n        padding-top: 60px;\\n    }\\n\\n    .hero-visual {\\n        justify-content: flex-start;\\n    }\\n\\n    .about-content {\\n        grid-template-columns: 1fr;\\n        gap: 45px;\\n    }\\n\\n    .services-grid,\\n    .why-me-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n\\n    .logo-grid,\\n    .poster-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n\\n    .video-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n}\\n\\n/* MOBILE */\\n\\n@media (max-width: 600px) {\\n\\n    .navbar {\\n        width: calc(100% - 20px);\\n        margin-top: 10px;\\n        padding: 10px;\\n    }\\n\\n    .logo {\\n        padding-left: 5px;\\n    }\\n\\n    .logo img {\\n        width: 60px;\\n    }\\n\\n    .nav-button {\\n        display: none;\\n    }\\n\\n    .nav-links {\\n        width: 100%;\\n        justify-content: flex-start;\\n        gap: 3px;\\n        overflow-x: auto;\\n    }\\n\\n    .nav-links a {\\n        padding: 8px 12px;\\n        font-size: 11px;\\n        white-space: nowrap;\\n    }\\n\\n    .hero {\\n        min-height: auto;\\n        padding: 60px 20px 75px;\\n        gap: 45px;\\n    }\\n\\n    .hero h1 {\\n        font-size: 46px;\\n        letter-spacing: -1.5px;\\n    }\\n\\n    .hero-description {\\n        font-size: 14px;\\n    }\\n\\n    .hero-card {\\n        min-height: 370px;\\n        padding: 32px;\\n    }\\n\\n    .hero-card h2 {\\n        font-size: 39px;\\n    }\\n\\n    .section {\\n        padding: 80px 20px;\\n    }\\n\\n    .section-heading {\\n        margin-bottom: 38px;\\n    }\\n\\n    .section-heading h2 {\\n        font-size: 36px;\\n    }\\n\\n    .services {\\n        padding-left: 20px;\\n        padding-right: 20px;\\n    }\\n\\n    .services-grid,\\n    .why-me-grid,\\n    .logo-grid,\\n    .poster-grid,\\n    .video-grid,\\n    .meta-ads-container {\\n        grid-template-columns: 1fr;\\n    }\\n\\n    .service-card {\\n        min-height: auto;\\n    }\\n\\n    .service-card h3 {\\n        margin-top: 32px;\\n    }\\n\\n    .portfolio-category {\\n        margin-bottom: 65px;\\n    }\\n\\n    .portfolio-filters {\\n        gap: 7px;\\n    }\\n\\n    .filter-button {\\n        padding: 8px 13px;\\n        font-size: 11px;\\n    }\\n\\n    .footer-content {\\n        flex-direction: column;\\n    }\\n\\n    .footer-links {\\n        gap: 15px;\\n    }\\n\\n    .contact {\\n        padding-top: 90px;\\n        padding-bottom: 90px;\\n    }\\n}\\n```\\n\\n**Ippudu just 3 steps:**\\n\\n**1.** `css → style.css` open cheyyi  \\n**2.** `Ctrl + A` → **Delete**  \\n**3.** Paina unna **full code paste → Ctrl + S**\\n\\nThen browser refresh cheyyi: **Ctrl + F5**.\\n\\nIdi previous code kanna **cleaner, modern, medium-color professional freelancer style** ga untundi.\",{},{\"_273\":1719,\"_280\":1743,\"_54\":1744,\"_56\":1744,\"_284\":1745,\"_286\":287,\"_289\":290,\"_291\":1746,\"_293\":294},\"2cdaef7b-abd3-4c94-86bb-bb52e7ffab9c\",[1705],{\"_343\":356,\"_291\":1748},1790859354.185078,{\"_338\":339,\"_340\":1747},{\"_353\":34,\"_306\":109,\"_311\":312,\"_314\":1732,\"_316\":317,\"_318\":1733,\"_320\":1733,\"_321\":109,\"_66\":67,\"_323\":1741,\"_324\":10,\"_322\":14},[355],{},{\"_273\":1741,\"_280\":1752,\"_54\":1753,\"_56\":1754,\"_284\":1755,\"_286\":287,\"_289\":290,\"_291\":1756,\"_293\":294},\"c89ecafb-5941-4b2f-b0a4-b2aae21ec80a\",[1719],{\"_343\":373,\"_291\":1762},1790859346.788,1790859381.480745,{\"_338\":339,\"_340\":1761},{\"_366\":1757,\"_456\":34,\"_457\":1758,\"_459\":1759,\"_461\":462,\"_314\":1732,\"_368\":-5,\"_318\":1733,\"_320\":1733,\"_463\":14,\"_324\":10,\"_322\":14},{\"_369\":1760},\"I'm confusing with where to add. So can you please give again one second code?\",\"sediment://file_0000000096648211abb8210720031b16\",[],[1758],{},{\"_273\":1750,\"_280\":1766,\"_54\":1767,\"_56\":1768,\"_284\":1769,\"_286\":287,\"_288\":34,\"_289\":290,\"_291\":1770,\"_293\":294,\"_295\":296},\"e4bf781d-338f-40ac-8f29-b9b5b35b81ca\",[1741],{\"_343\":344,\"_291\":1786},1790859318.315304,1790859325.285589,{\"_338\":339,\"_340\":1784},{\"_297\":1771,\"_299\":34,\"_300\":1772,\"_302\":1773,\"_304\":1774,\"_306\":109,\"_307\":1775,\"_309\":1776,\"_311\":312,\"_313\":34,\"_314\":1777,\"_316\":317,\"_318\":1778,\"_320\":1778,\"_321\":109,\"_66\":67,\"_322\":34,\"_323\":1764,\"_324\":10},{\"_50\":334,\"_335\":1783},[],[],[],{\"_325\":1779,\"_327\":1780},[],\"7f8aa947-af3a-4376-8b1f-ff4cb4f0437f\",\"c51bdb5f-88e2-4b53-8a59-cdbbd212b364\",{\"_273\":1782,\"_330\":14,\"_331\":14,\"_332\":-5},{\"_273\":1781,\"_330\":14,\"_331\":14,\"_332\":-5},\"e1h86a\",\"psoxk6\",[337],[1785],\"Yes ra, I understand. The issue is mainly the **top navbar** — the logo + Home/About/Services/My Work/Contact + button are looking too plain/basic.\\n\\nLet's make the navbar more premium:\\n- Better spacing\\n- Subtle rounded navigation\\n- Active/hover indicator\\n- Cleaner CTA button\\n- No unnecessary icons\\n- Professional medium colors matching the new blue/navy theme\\n\\nReplace **only the navbar-related CSS** in your `style.css` with this:\\n\\n```css\\n.navbar {\\n    width: calc(100% - 40px);\\n    max-width: 1180px;\\n    margin: 18px auto 0;\\n    padding: 12px 14px;\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    gap: 25px;\\n    background: rgba(255, 255, 255, 0.92);\\n    border: 1px solid #e1e6ee;\\n    border-radius: 14px;\\n    box-shadow: 0 6px 25px rgba(16, 24, 40, 0.05);\\n}\\n\\n.logo {\\n    display: flex;\\n    align-items: center;\\n    padding-left: 8px;\\n}\\n\\n.logo img {\\n    width: 68px;\\n    height: auto;\\n}\\n\\n.nav-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 6px;\\n    padding: 4px;\\n    background: #f1f4f8;\\n    border-radius: 10px;\\n}\\n\\n.nav-links a {\\n    position: relative;\\n    padding: 9px 15px;\\n    color: #526071;\\n    font-size: 13px;\\n    font-weight: 500;\\n    border-radius: 7px;\\n    transition: all 0.3s ease;\\n}\\n\\n.nav-links a:hover {\\n    color: #1f5edb;\\n    background: #ffffff;\\n}\\n\\n.nav-links a:first-child {\\n    color: #1f5edb;\\n    background: #ffffff;\\n    box-shadow: 0 2px 8px rgba(16, 24, 40, 0.06);\\n}\\n\\n.nav-button {\\n    display: inline-flex;\\n    align-items: center;\\n    justify-content: center;\\n    padding: 10px 18px;\\n    background: #1f5edb;\\n    color: #ffffff;\\n    border-radius: 8px;\\n    font-size: 12px;\\n    font-weight: 600;\\n    white-space: nowrap;\\n    transition: all 0.3s ease;\\n}\\n\\n.nav-button:hover {\\n    background: #1749ad;\\n    transform: translateY(-1px);\\n}\\n```\\n\\nAlso, **mobile navbar** part ni replace cheyyi:\\n\\n```css\\n@media (max-width: 900px) {\\n    .navbar {\\n        width: calc(100% - 30px);\\n        flex-wrap: wrap;\\n        padding: 12px;\\n    }\\n\\n    .nav-links {\\n        order: 3;\\n        width: 100%;\\n        justify-content: center;\\n        overflow-x: auto;\\n    }\\n}\\n\\n@media (max-width: 600px) {\\n    .navbar {\\n        width: calc(100% - 20px);\\n        margin-top: 10px;\\n        padding: 10px;\\n    }\\n\\n    .logo img {\\n        width: 60px;\\n    }\\n\\n    .nav-button {\\n        display: none;\\n    }\\n\\n    .nav-links {\\n        width: 100%;\\n        justify-content: flex-start;\\n        gap: 3px;\\n        overflow-x: auto;\\n    }\\n\\n    .nav-links a {\\n        padding: 8px 12px;\\n        font-size: 11px;\\n        white-space: nowrap;\\n    }\\n}\\n```\\n\\nOne important thing: **mana HTML lo currently icons emi levu**. So if by \\\"icons\\\" you mean small Home 🏠, About 👤, Services ⚙️ type icons, I would **not add random emoji icons**. For a professional freelancer website, simple line icons would look much cleaner.\",{},{\"_273\":1764,\"_280\":1790,\"_54\":1791,\"_56\":1791,\"_284\":1792,\"_286\":287,\"_289\":290,\"_291\":1793,\"_293\":294},\"58d54aac-a8ad-4d7d-b3f0-df86ecbe8453\",[1750],{\"_343\":356,\"_291\":1795},1790859318.310856,{\"_338\":339,\"_340\":1794},{\"_353\":34,\"_306\":109,\"_311\":312,\"_314\":1777,\"_316\":317,\"_318\":1778,\"_320\":1778,\"_321\":109,\"_66\":67,\"_323\":1788,\"_324\":10,\"_322\":14},[355],{},{\"_273\":1788,\"_280\":1799,\"_54\":1800,\"_56\":1801,\"_284\":1802,\"_286\":287,\"_289\":290,\"_291\":1803,\"_293\":294},\"431b98ee-9793-408b-b9de-3d54d9ac8640\",[1764],{\"_343\":373,\"_291\":1809},1790859308.677,1790859325.797846,{\"_338\":339,\"_340\":1808},{\"_366\":1804,\"_456\":34,\"_457\":1805,\"_459\":1806,\"_461\":462,\"_314\":1777,\"_368\":-5,\"_318\":1778,\"_320\":1778,\"_463\":14,\"_324\":10,\"_322\":14},{\"_369\":1807},\"I want the coloring and icons for home, contact, which you displayed in the top of the section. That is not looking very nice.\",\"sediment://file_00000000ec908208b4878e7c8320deef\",[],[1805],{},{\"_273\":1797,\"_280\":1813,\"_54\":1814,\"_56\":1815,\"_284\":1816,\"_286\":287,\"_288\":34,\"_289\":290,\"_291\":1817,\"_293\":294,\"_295\":296},\"3f3bb386-8faf-42fd-b633-f11e160c6068\",[1788],{\"_343\":344,\"_291\":1831},1790859184.216836,1790859267.676079,{\"_338\":339,\"_340\":1829},{\"_297\":1818,\"_299\":34,\"_300\":1819,\"_302\":1820,\"_304\":1821,\"_306\":109,\"_307\":1822,\"_309\":1823,\"_311\":312,\"_313\":34,\"_314\":1824,\"_316\":317,\"_318\":1825,\"_320\":1825,\"_321\":109,\"_66\":67,\"_322\":34,\"_323\":1811,\"_324\":10},{\"_50\":334,\"_335\":1828},[],[],[],{\"_325\":1826},[],\"67b9299a-affb-4674-b34a-5cbe6e057582\",\"a9794693-df7f-4be6-8b5c-f333ffd60bf9\",{\"_273\":1827,\"_330\":14,\"_331\":14,\"_332\":-5},\"6dqn9e\",[337],[1830],\"Yes ra. I understand what you mean — previous one was **too beige/dull**. Let's make it more **modern professional**, with a medium-tone palette: clean white/soft gray base, deep navy/charcoal text, and a subtle blue accent. Not flashy, not dull.\\n\\nReplace the entire `style.css` with this:\\n\\n```css\\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700\u0026family=Manrope:wght@600;700;800\u0026display=swap');\\n\\n:root {\\n    --bg: #f5f7fa;\\n    --white: #ffffff;\\n    --surface: #eef2f6;\\n    --text: #18212f;\\n    --heading: #101828;\\n    --muted: #667085;\\n    --accent: #356ae6;\\n    --accent-dark: #2454c7;\\n    --accent-soft: #e8efff;\\n    --dark: #172033;\\n    --border: #dfe4ec;\\n    --shadow: 0 12px 35px rgba(16, 24, 40, 0.07);\\n    --radius: 16px;\\n    --max-width: 1180px;\\n}\\n\\n* {\\n    margin: 0;\\n    padding: 0;\\n    box-sizing: border-box;\\n}\\n\\nhtml {\\n    scroll-behavior: smooth;\\n}\\n\\nbody {\\n    font-family: 'DM Sans', sans-serif;\\n    background: var(--bg);\\n    color: var(--text);\\n    line-height: 1.6;\\n}\\n\\nimg,\\nvideo {\\n    max-width: 100%;\\n    display: block;\\n}\\n\\na {\\n    color: inherit;\\n    text-decoration: none;\\n}\\n\\nbutton {\\n    font-family: inherit;\\n}\\n\\n.navbar {\\n    width: 100%;\\n    max-width: var(--max-width);\\n    margin: auto;\\n    padding: 20px 25px;\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    gap: 30px;\\n}\\n\\n.logo img {\\n    width: 72px;\\n    height: auto;\\n}\\n\\n.nav-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 30px;\\n}\\n\\n.nav-links a {\\n    color: #475467;\\n    font-size: 14px;\\n    font-weight: 500;\\n    transition: 0.3s ease;\\n}\\n\\n.nav-links a:hover {\\n    color: var(--accent);\\n}\\n\\n.nav-button {\\n    padding: 11px 20px;\\n    background: var(--dark);\\n    color: white;\\n    border-radius: 8px;\\n    font-size: 13px;\\n    font-weight: 600;\\n    transition: 0.3s ease;\\n}\\n\\n.nav-button:hover {\\n    background: var(--accent);\\n}\\n\\n.hero {\\n    max-width: var(--max-width);\\n    min-height: 650px;\\n    margin: auto;\\n    padding: 75px 25px;\\n    display: grid;\\n    grid-template-columns: 1.1fr 0.9fr;\\n    align-items: center;\\n    gap: 70px;\\n}\\n\\n.hero-small-text,\\n.section-label {\\n    color: var(--accent);\\n    font-size: 12px;\\n    font-weight: 700;\\n    letter-spacing: 1.8px;\\n}\\n\\n.hero h1 {\\n    margin-top: 14px;\\n    font-family: 'Manrope', sans-serif;\\n    color: var(--heading);\\n    font-size: clamp(48px, 6vw, 72px);\\n    line-height: 1.08;\\n    font-weight: 800;\\n    letter-spacing: -2.5px;\\n}\\n\\n.hero-description {\\n    max-width: 570px;\\n    margin-top: 25px;\\n    color: var(--muted);\\n    font-size: 16px;\\n    line-height: 1.8;\\n}\\n\\n.hero-buttons,\\n.contact-buttons {\\n    margin-top: 32px;\\n    display: flex;\\n    align-items: center;\\n    gap: 12px;\\n    flex-wrap: wrap;\\n}\\n\\n.primary-button,\\n.secondary-button {\\n    display: inline-flex;\\n    align-items: center;\\n    justify-content: center;\\n    padding: 13px 22px;\\n    border-radius: 8px;\\n    font-size: 13px;\\n    font-weight: 600;\\n    transition: 0.3s ease;\\n}\\n\\n.primary-button {\\n    background: var(--accent);\\n    color: white;\\n}\\n\\n.primary-button:hover {\\n    background: var(--accent-dark);\\n    transform: translateY(-2px);\\n}\\n\\n.secondary-button {\\n    background: white;\\n    color: var(--text);\\n    border: 1px solid var(--border);\\n}\\n\\n.secondary-button:hover {\\n    border-color: var(--accent);\\n    color: var(--accent);\\n}\\n\\n.hero-visual {\\n    display: flex;\\n    justify-content: center;\\n}\\n\\n.hero-card {\\n    width: 100%;\\n    max-width: 390px;\\n    min-height: 450px;\\n    padding: 42px;\\n    border-radius: 22px;\\n    background: linear-gradient(145deg, #263550, #172033);\\n    color: white;\\n    display: flex;\\n    flex-direction: column;\\n    justify-content: flex-end;\\n    position: relative;\\n    overflow: hidden;\\n    box-shadow: 0 25px 55px rgba(23, 32, 51, 0.18);\\n}\\n\\n.hero-card::before {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 220px;\\n    height: 220px;\\n    border-radius: 50%;\\n    background: rgba(53, 106, 230, 0.25);\\n    top: -70px;\\n    right: -60px;\\n}\\n\\n.hero-card::after {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 140px;\\n    height: 140px;\\n    border: 1px solid rgba(255, 255, 255, 0.15);\\n    border-radius: 50%;\\n    top: 60px;\\n    right: 45px;\\n}\\n\\n.hero-card p,\\n.hero-card h2,\\n.hero-card span {\\n    position: relative;\\n    z-index: 2;\\n}\\n\\n.hero-card p {\\n    color: #9ebaff;\\n    font-size: 11px;\\n    letter-spacing: 3px;\\n    font-weight: 700;\\n}\\n\\n.hero-card h2 {\\n    margin-top: 12px;\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 46px;\\n    line-height: 1.08;\\n}\\n\\n.hero-card span {\\n    margin-top: 25px;\\n    color: #cbd5e1;\\n    font-size: 12px;\\n}\\n\\n.section {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    padding: 105px 25px;\\n}\\n\\n.section-heading {\\n    max-width: 700px;\\n    margin-bottom: 50px;\\n}\\n\\n.section-heading h2 {\\n    margin-top: 10px;\\n    font-family: 'Manrope', sans-serif;\\n    color: var(--heading);\\n    font-size: clamp(36px, 5vw, 52px);\\n    line-height: 1.12;\\n    letter-spacing: -1.5px;\\n}\\n\\n.section-heading \u003e p:last-child {\\n    margin-top: 14px;\\n    color: var(--muted);\\n}\\n\\n.about-content {\\n    display: grid;\\n    grid-template-columns: 1fr 1fr;\\n    gap: 65px;\\n    align-items: start;\\n}\\n\\n.about-text {\\n    display: flex;\\n    flex-direction: column;\\n    gap: 18px;\\n}\\n\\n.about-text p {\\n    color: #536174;\\n    font-size: 15px;\\n    line-height: 1.9;\\n}\\n\\n.about-highlights {\\n    display: grid;\\n    gap: 14px;\\n}\\n\\n.highlight-card {\\n    padding: 26px;\\n    background: var(--white);\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    box-shadow: 0 5px 20px rgba(16, 24, 40, 0.03);\\n    transition: 0.3s ease;\\n}\\n\\n.highlight-card:hover {\\n    transform: translateY(-3px);\\n    box-shadow: var(--shadow);\\n}\\n\\n.highlight-card h3 {\\n    color: var(--heading);\\n    font-size: 18px;\\n}\\n\\n.highlight-card p {\\n    margin-top: 7px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n.services {\\n    max-width: none;\\n    padding-left: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    padding-right: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    background: #e9edf3;\\n}\\n\\n.services-grid {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: 18px;\\n}\\n\\n.service-card {\\n    min-height: 235px;\\n    padding: 28px;\\n    background: white;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    position: relative;\\n    overflow: hidden;\\n    transition: 0.3s ease;\\n}\\n\\n.service-card:hover {\\n    transform: translateY(-5px);\\n    border-color: #b9c9ee;\\n    box-shadow: var(--shadow);\\n}\\n\\n.service-number {\\n    color: var(--accent);\\n    font-size: 12px;\\n    font-weight: 700;\\n}\\n\\n.service-card h3 {\\n    margin-top: 48px;\\n    color: var(--heading);\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 19px;\\n}\\n\\n.service-card p {\\n    margin-top: 9px;\\n    color: var(--muted);\\n    font-size: 13px;\\n    line-height: 1.7;\\n}\\n\\n.portfolio-filters {\\n    display: flex;\\n    gap: 9px;\\n    flex-wrap: wrap;\\n    margin-bottom: 50px;\\n}\\n\\n.filter-button {\\n    padding: 9px 18px;\\n    border: 1px solid var(--border);\\n    border-radius: 8px;\\n    background: white;\\n    color: #475467;\\n    cursor: pointer;\\n    font-size: 12px;\\n    font-weight: 500;\\n    transition: 0.3s ease;\\n}\\n\\n.filter-button:hover,\\n.filter-button.active {\\n    background: var(--accent);\\n    color: white;\\n    border-color: var(--accent);\\n}\\n\\n.portfolio-category {\\n    margin-bottom: 85px;\\n}\\n\\n.category-heading {\\n    margin-bottom: 23px;\\n}\\n\\n.category-heading h3 {\\n    color: var(--heading);\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 27px;\\n}\\n\\n.category-heading p {\\n    margin-top: 5px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n.portfolio-grid {\\n    display: grid;\\n    gap: 20px;\\n}\\n\\n.logo-grid,\\n.poster-grid {\\n    grid-template-columns: repeat(3, 1fr);\\n}\\n\\n.portfolio-card {\\n    background: white;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    overflow: hidden;\\n    transition: 0.3s ease;\\n}\\n\\n.portfolio-card:hover {\\n    transform: translateY(-5px);\\n    box-shadow: var(--shadow);\\n}\\n\\n.portfolio-image {\\n    width: 100%;\\n    aspect-ratio: 1 / 1;\\n    background: #edf0f4;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n.portfolio-image img {\\n    width: 100%;\\n    height: 100%;\\n    object-fit: contain;\\n}\\n\\n.portfolio-info {\\n    padding: 18px 20px;\\n}\\n\\n.portfolio-info h4 {\\n    color: var(--heading);\\n    font-size: 15px;\\n    font-weight: 600;\\n}\\n\\n.portfolio-info p {\\n    margin-top: 3px;\\n    color: var(--muted);\\n    font-size: 12px;\\n}\\n\\n.video-grid {\\n    grid-template-columns: repeat(3, minmax(0, 1fr));\\n    align-items: start;\\n}\\n\\n.video-container {\\n    width: 100%;\\n    background: #111827;\\n    display: flex;\\n    justify-content: center;\\n}\\n\\n.video-container video {\\n    width: 100%;\\n    height: auto;\\n    max-height: 650px;\\n    object-fit: contain;\\n}\\n\\n.meta-ads-container {\\n    display: grid;\\n    grid-template-columns: repeat(2, minmax(0, 1fr));\\n    gap: 22px;\\n}\\n\\n.report-image {\\n    width: 100%;\\n    background: #edf0f4;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n.report-image img {\\n    width: 100%;\\n    height: auto;\\n    object-fit: contain;\\n}\\n\\n.coming-soon {\\n    min-height: 210px;\\n    border: 1px dashed #bfc7d4;\\n    border-radius: var(--radius);\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    justify-content: center;\\n    text-align: center;\\n    background: white;\\n}\\n\\n.coming-soon span {\\n    padding: 8px 17px;\\n    border-radius: 7px;\\n    background: var(--accent-soft);\\n    color: var(--accent-dark);\\n    font-size: 11px;\\n    font-weight: 700;\\n}\\n\\n.coming-soon p {\\n    margin-top: 10px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n.why-me {\\n    max-width: none;\\n    background: #172033;\\n    color: white;\\n    padding-left: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    padding-right: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n}\\n\\n.why-me .section-heading {\\n    max-width: var(--max-width);\\n    margin-left: auto;\\n    margin-right: auto;\\n}\\n\\n.why-me .section-heading h2 {\\n    color: white;\\n}\\n\\n.why-me .section-label {\\n    color: #8facff;\\n}\\n\\n.why-me-grid {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: 18px;\\n}\\n\\n.why-card {\\n    padding: 28px;\\n    border: 1px solid #303b51;\\n    border-radius: var(--radius);\\n    background: rgba(255, 255, 255, 0.025);\\n    transition: 0.3s ease;\\n}\\n\\n.why-card:hover {\\n    background: rgba(255, 255, 255, 0.05);\\n    border-color: #45536e;\\n}\\n\\n.why-card h3 {\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 18px;\\n}\\n\\n.why-card p {\\n    margin-top: 10px;\\n    color: #aeb8c9;\\n    font-size: 13px;\\n    line-height: 1.7;\\n}\\n\\n.contact {\\n    text-align: center;\\n    padding-top: 120px;\\n    padding-bottom: 120px;\\n}\\n\\n.contact-content {\\n    max-width: 800px;\\n    margin: auto;\\n}\\n\\n.contact h2 {\\n    margin-top: 12px;\\n    font-family: 'Manrope', sans-serif;\\n    color: var(--heading);\\n    font-size: clamp(38px, 6vw, 60px);\\n    line-height: 1.12;\\n    letter-spacing: -1.5px;\\n}\\n\\n.contact-content \u003e p:not(.section-label) {\\n    max-width: 600px;\\n    margin: 18px auto 0;\\n    color: var(--muted);\\n}\\n\\n.contact-buttons {\\n    justify-content: center;\\n}\\n\\n.footer {\\n    background: #101828;\\n    color: white;\\n    padding: 48px 25px 22px;\\n}\\n\\n.footer-content {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: flex;\\n    justify-content: space-between;\\n    gap: 40px;\\n}\\n\\n.footer-brand h3 {\\n    font-family: 'Manrope', sans-serif;\\n    font-size: 22px;\\n}\\n\\n.footer-brand p {\\n    margin-top: 4px;\\n    color: #98a2b3;\\n    font-size: 12px;\\n}\\n\\n.footer-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 24px;\\n    flex-wrap: wrap;\\n}\\n\\n.footer-links a {\\n    color: #b5bfce;\\n    font-size: 12px;\\n    transition: 0.3s ease;\\n}\\n\\n.footer-links a:hover {\\n    color: white;\\n}\\n\\n.footer-bottom {\\n    max-width: var(--max-width);\\n    margin: 35px auto 0;\\n    padding-top: 18px;\\n    border-top: 1px solid #263247;\\n}\\n\\n.footer-bottom p {\\n    color: #667085;\\n    font-size: 11px;\\n}\\n\\n.portfolio-card.hidden {\\n    display: none;\\n}\\n\\n@media (max-width: 900px) {\\n    .navbar {\\n        flex-wrap: wrap;\\n    }\\n\\n    .nav-links {\\n        order: 3;\\n        width: 100%;\\n        justify-content: center;\\n        gap: 20px;\\n    }\\n\\n    .hero {\\n        grid-template-columns: 1fr;\\n        padding-top: 60px;\\n    }\\n\\n    .hero-visual {\\n        justify-content: flex-start;\\n    }\\n\\n    .about-content {\\n        grid-template-columns: 1fr;\\n        gap: 45px;\\n    }\\n\\n    .services-grid,\\n    .why-me-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n\\n    .logo-grid,\\n    .poster-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n\\n    .video-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n}\\n\\n@media (max-width: 600px) {\\n    .navbar {\\n        padding: 17px 20px;\\n    }\\n\\n    .logo img {\\n        width: 64px;\\n    }\\n\\n    .nav-button {\\n        display: none;\\n    }\\n\\n    .nav-links {\\n        justify-content: flex-start;\\n        gap: 16px;\\n        overflow-x: auto;\\n        padding-bottom: 4px;\\n    }\\n\\n    .nav-links a {\\n        white-space: nowrap;\\n        font-size: 12px;\\n    }\\n\\n    .hero {\\n        min-height: auto;\\n        padding: 60px 20px 75px;\\n        gap: 45px;\\n    }\\n\\n    .hero h1 {\\n        font-size: 46px;\\n        letter-spacing: -1.5px;\\n    }\\n\\n    .hero-description {\\n        font-size: 14px;\\n    }\\n\\n    .hero-card {\\n        min-height: 370px;\\n        padding: 32px;\\n    }\\n\\n    .hero-card h2 {\\n        font-size: 39px;\\n    }\\n\\n    .section {\\n        padding: 80px 20px;\\n    }\\n\\n    .section-heading {\\n        margin-bottom: 38px;\\n    }\\n\\n    .section-heading h2 {\\n        font-size: 36px;\\n    }\\n\\n    .services {\\n        padding-left: 20px;\\n        padding-right: 20px;\\n    }\\n\\n    .services-grid,\\n    .why-me-grid,\\n    .logo-grid,\\n    .poster-grid,\\n    .video-grid,\\n    .meta-ads-container {\\n        grid-template-columns: 1fr;\\n    }\\n\\n    .service-card {\\n        min-height: auto;\\n    }\\n\\n    .service-card h3 {\\n        margin-top: 32px;\\n    }\\n\\n    .portfolio-category {\\n        margin-bottom: 65px;\\n    }\\n\\n    .portfolio-filters {\\n        gap: 7px;\\n    }\\n\\n    .filter-button {\\n        padding: 8px 13px;\\n        font-size: 11px;\\n    }\\n\\n    .footer-content {\\n        flex-direction: column;\\n    }\\n\\n    .footer-links {\\n        gap: 15px;\\n    }\\n\\n    .contact {\\n        padding-top: 90px;\\n        padding-bottom: 90px;\\n    }\\n}\\n```\\n\\n### Ee version lo main difference\\n\\n- **Background:** soft cool gray — dull ga undadu\\n- **Main accent:** professional medium blue\\n- **Text:** dark navy, pure black kaadu\\n- **Cards:** clean white\\n- **Hero:** dark navy + subtle blue\\n- **Services:** slightly darker gray section\\n- **Why Work With Me:** premium dark section\\n- **Buttons:** blue, but neon/bright blue kaadu\\n- **Shadows:** very subtle\\n- **Overall:** **professional agency/freelancer website feel**\\n\\nAnd importantly, nee **logos/posters/videos/reports original aspect ratio** ni unnecessarily stretch cheyyadu.\",{},{\"_273\":1811,\"_280\":1835,\"_54\":1836,\"_56\":1836,\"_284\":1837,\"_286\":287,\"_289\":290,\"_291\":1838,\"_293\":294},\"f6b068b0-72ae-4a71-9da8-9ad21ffcff08\",[1797],{\"_343\":356,\"_291\":1840},1790859184.20737,{\"_338\":339,\"_340\":1839},{\"_353\":34,\"_306\":109,\"_311\":312,\"_314\":1824,\"_316\":317,\"_318\":1825,\"_320\":1825,\"_321\":109,\"_66\":67,\"_323\":1833,\"_324\":10,\"_322\":14},[355],{},{\"_273\":1833,\"_280\":1844,\"_54\":1845,\"_56\":1846,\"_284\":1847,\"_286\":287,\"_289\":290,\"_291\":1848,\"_293\":294},\"12dc1eb0-2715-4e59-8198-45990ee27024\",[1811],{\"_343\":373,\"_291\":1854},1790859174.815,1790859210.965194,{\"_338\":339,\"_340\":1853},{\"_366\":1849,\"_456\":34,\"_457\":1850,\"_459\":1851,\"_461\":462,\"_314\":1824,\"_368\":-5,\"_318\":1825,\"_320\":1825,\"_463\":14,\"_324\":10,\"_322\":14},{\"_369\":1852},\"I didn't like that color. So too much dulling na. Can you please give a CSS code with a professional look? Not very too much bright. Not very too much light. I want in medium level. Can you please give another code for that? Make it professional.\",\"sediment://file_0000000057388211924325ad201236ba\",[],[1850],{},{\"_273\":1842,\"_280\":1858,\"_54\":1859,\"_56\":1860,\"_284\":1861,\"_286\":287,\"_288\":34,\"_289\":290,\"_291\":1862,\"_293\":294,\"_295\":296},\"c300df57-82db-448f-adac-1d7791f41f03\",[1833],{\"_343\":344,\"_291\":1876},1790859078.62234,1790859116.661652,{\"_338\":339,\"_340\":1874},{\"_297\":1863,\"_299\":34,\"_300\":1864,\"_302\":1865,\"_304\":1866,\"_306\":109,\"_307\":1867,\"_309\":1868,\"_311\":312,\"_313\":34,\"_314\":1869,\"_316\":317,\"_318\":1870,\"_320\":1870,\"_321\":109,\"_66\":67,\"_322\":34,\"_323\":1856,\"_324\":10},{\"_50\":334,\"_335\":1873},[],[],[],{\"_325\":1871},[],\"4f37d10b-751c-4fff-9b55-a8d0e01107ac\",\"45a144f5-b565-4a5b-be44-6e080d8906d9\",{\"_273\":1872,\"_330\":14,\"_331\":14,\"_332\":-5},\"b2jjfh\",[337],[1875],\"Sure ra. `css/style.css` lo unna old code motham remove chesi **ee complete code** paste cheyyi.\\n\\n```css\\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700\u0026family=Playfair+Display:wght@600;700\u0026display=swap');\\n\\n:root {\\n    --bg: #f7f6f2;\\n    --surface: #ffffff;\\n    --text: #171717;\\n    --muted: #6f6f6f;\\n    --accent: #c9a66b;\\n    --accent-dark: #a8844d;\\n    --border: #e6e3dc;\\n    --dark: #171717;\\n    --radius: 18px;\\n    --max-width: 1180px;\\n}\\n\\n* {\\n    margin: 0;\\n    padding: 0;\\n    box-sizing: border-box;\\n}\\n\\nhtml {\\n    scroll-behavior: smooth;\\n}\\n\\nbody {\\n    font-family: 'DM Sans', sans-serif;\\n    background: var(--bg);\\n    color: var(--text);\\n    line-height: 1.6;\\n}\\n\\nimg,\\nvideo {\\n    max-width: 100%;\\n    display: block;\\n}\\n\\na {\\n    color: inherit;\\n    text-decoration: none;\\n}\\n\\nbutton {\\n    font-family: inherit;\\n}\\n\\n.navbar {\\n    width: 100%;\\n    max-width: var(--max-width);\\n    margin: auto;\\n    padding: 22px 25px;\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    gap: 30px;\\n}\\n\\n.logo img {\\n    width: 75px;\\n    height: auto;\\n}\\n\\n.nav-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 30px;\\n}\\n\\n.nav-links a {\\n    font-size: 14px;\\n    font-weight: 500;\\n    transition: 0.3s ease;\\n}\\n\\n.nav-links a:hover {\\n    color: var(--accent-dark);\\n}\\n\\n.nav-button {\\n    padding: 12px 20px;\\n    border: 1px solid var(--text);\\n    border-radius: 30px;\\n    font-size: 14px;\\n    font-weight: 600;\\n    transition: 0.3s ease;\\n}\\n\\n.nav-button:hover {\\n    background: var(--dark);\\n    color: white;\\n}\\n\\n.hero {\\n    max-width: var(--max-width);\\n    min-height: 650px;\\n    margin: auto;\\n    padding: 80px 25px;\\n    display: grid;\\n    grid-template-columns: 1.15fr 0.85fr;\\n    align-items: center;\\n    gap: 70px;\\n}\\n\\n.hero-small-text,\\n.section-label {\\n    color: var(--accent-dark);\\n    font-size: 12px;\\n    font-weight: 700;\\n    letter-spacing: 2px;\\n}\\n\\n.hero h1 {\\n    margin-top: 15px;\\n    font-family: 'Playfair Display', serif;\\n    font-size: clamp(48px, 6vw, 78px);\\n    line-height: 1.05;\\n    font-weight: 700;\\n    letter-spacing: -2px;\\n}\\n\\n.hero-description {\\n    max-width: 560px;\\n    margin-top: 25px;\\n    color: var(--muted);\\n    font-size: 17px;\\n    line-height: 1.8;\\n}\\n\\n.hero-buttons,\\n.contact-buttons {\\n    margin-top: 35px;\\n    display: flex;\\n    align-items: center;\\n    gap: 15px;\\n    flex-wrap: wrap;\\n}\\n\\n.primary-button,\\n.secondary-button {\\n    display: inline-flex;\\n    align-items: center;\\n    justify-content: center;\\n    padding: 14px 25px;\\n    border-radius: 30px;\\n    font-size: 14px;\\n    font-weight: 600;\\n    transition: 0.3s ease;\\n}\\n\\n.primary-button {\\n    background: var(--dark);\\n    color: white;\\n}\\n\\n.primary-button:hover {\\n    background: var(--accent-dark);\\n    transform: translateY(-2px);\\n}\\n\\n.secondary-button {\\n    border: 1px solid var(--border);\\n    background: white;\\n}\\n\\n.secondary-button:hover {\\n    border-color: var(--dark);\\n}\\n\\n.hero-visual {\\n    display: flex;\\n    justify-content: center;\\n}\\n\\n.hero-card {\\n    width: 100%;\\n    max-width: 390px;\\n    min-height: 460px;\\n    padding: 45px;\\n    border-radius: 28px;\\n    background: #e9e3d7;\\n    display: flex;\\n    flex-direction: column;\\n    justify-content: flex-end;\\n    position: relative;\\n    overflow: hidden;\\n}\\n\\n.hero-card::before {\\n    content: \\\"\\\";\\n    position: absolute;\\n    width: 240px;\\n    height: 240px;\\n    border-radius: 50%;\\n    background: rgba(255, 255, 255, 0.45);\\n    top: -70px;\\n    right: -70px;\\n}\\n\\n.hero-card p {\\n    position: relative;\\n    font-size: 12px;\\n    letter-spacing: 3px;\\n    font-weight: 700;\\n}\\n\\n.hero-card h2 {\\n    position: relative;\\n    margin-top: 12px;\\n    font-family: 'Playfair Display', serif;\\n    font-size: 48px;\\n    line-height: 1.05;\\n}\\n\\n.hero-card span {\\n    position: relative;\\n    margin-top: 25px;\\n    color: #666;\\n    font-size: 13px;\\n}\\n\\n.section {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    padding: 110px 25px;\\n}\\n\\n.section-heading {\\n    max-width: 700px;\\n    margin-bottom: 55px;\\n}\\n\\n.section-heading h2 {\\n    margin-top: 10px;\\n    font-family: 'Playfair Display', serif;\\n    font-size: clamp(36px, 5vw, 55px);\\n    line-height: 1.1;\\n}\\n\\n.section-heading \u003e p:last-child {\\n    margin-top: 15px;\\n    color: var(--muted);\\n}\\n\\n.about-content {\\n    display: grid;\\n    grid-template-columns: 1fr 1fr;\\n    gap: 70px;\\n    align-items: start;\\n}\\n\\n.about-text {\\n    display: flex;\\n    flex-direction: column;\\n    gap: 20px;\\n}\\n\\n.about-text p {\\n    color: #555;\\n    font-size: 16px;\\n    line-height: 1.9;\\n}\\n\\n.about-highlights {\\n    display: grid;\\n    gap: 15px;\\n}\\n\\n.highlight-card {\\n    padding: 28px;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    background: var(--surface);\\n}\\n\\n.highlight-card h3 {\\n    font-size: 19px;\\n    margin-bottom: 8px;\\n}\\n\\n.highlight-card p {\\n    color: var(--muted);\\n    font-size: 14px;\\n}\\n\\n.services {\\n    background: #efede7;\\n    max-width: none;\\n    padding-left: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    padding-right: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n}\\n\\n.services-grid {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: 18px;\\n}\\n\\n.service-card {\\n    min-height: 240px;\\n    padding: 30px;\\n    background: white;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    transition: 0.3s ease;\\n}\\n\\n.service-card:hover {\\n    transform: translateY(-5px);\\n    border-color: var(--accent);\\n}\\n\\n.service-number {\\n    color: var(--accent-dark);\\n    font-size: 13px;\\n    font-weight: 700;\\n}\\n\\n.service-card h3 {\\n    margin-top: 55px;\\n    font-size: 21px;\\n}\\n\\n.service-card p {\\n    margin-top: 10px;\\n    color: var(--muted);\\n    font-size: 14px;\\n    line-height: 1.7;\\n}\\n\\n.portfolio-filters {\\n    display: flex;\\n    gap: 10px;\\n    flex-wrap: wrap;\\n    margin-bottom: 55px;\\n}\\n\\n.filter-button {\\n    padding: 10px 20px;\\n    border: 1px solid var(--border);\\n    border-radius: 30px;\\n    background: white;\\n    color: var(--text);\\n    cursor: pointer;\\n    font-size: 13px;\\n    transition: 0.3s ease;\\n}\\n\\n.filter-button:hover,\\n.filter-button.active {\\n    background: var(--dark);\\n    color: white;\\n    border-color: var(--dark);\\n}\\n\\n.portfolio-category {\\n    margin-bottom: 90px;\\n}\\n\\n.category-heading {\\n    margin-bottom: 25px;\\n}\\n\\n.category-heading h3 {\\n    font-family: 'Playfair Display', serif;\\n    font-size: 30px;\\n}\\n\\n.category-heading p {\\n    margin-top: 5px;\\n    color: var(--muted);\\n    font-size: 14px;\\n}\\n\\n.portfolio-grid {\\n    display: grid;\\n    gap: 20px;\\n}\\n\\n.logo-grid,\\n.poster-grid {\\n    grid-template-columns: repeat(3, 1fr);\\n}\\n\\n.portfolio-card {\\n    background: white;\\n    border: 1px solid var(--border);\\n    border-radius: var(--radius);\\n    overflow: hidden;\\n    transition: 0.3s ease;\\n}\\n\\n.portfolio-card:hover {\\n    transform: translateY(-5px);\\n}\\n\\n.portfolio-image {\\n    width: 100%;\\n    aspect-ratio: 1 / 1;\\n    background: #eeece7;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n.portfolio-image img {\\n    width: 100%;\\n    height: 100%;\\n    object-fit: contain;\\n}\\n\\n.portfolio-info {\\n    padding: 20px;\\n}\\n\\n.portfolio-info h4 {\\n    font-size: 16px;\\n    font-weight: 600;\\n}\\n\\n.portfolio-info p {\\n    margin-top: 4px;\\n    color: var(--muted);\\n    font-size: 13px;\\n}\\n\\n.video-grid {\\n    grid-template-columns: repeat(3, minmax(0, 1fr));\\n    align-items: start;\\n}\\n\\n.video-container {\\n    width: 100%;\\n    background: #111;\\n    display: flex;\\n    justify-content: center;\\n}\\n\\n.video-container video {\\n    width: 100%;\\n    height: auto;\\n    max-height: 650px;\\n    object-fit: contain;\\n}\\n\\n.meta-ads-container {\\n    display: grid;\\n    grid-template-columns: repeat(2, minmax(0, 1fr));\\n    gap: 25px;\\n}\\n\\n.report-image {\\n    width: 100%;\\n    background: #eeece7;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n}\\n\\n.report-image img {\\n    width: 100%;\\n    height: auto;\\n    object-fit: contain;\\n}\\n\\n.coming-soon {\\n    min-height: 220px;\\n    border: 1px dashed #c9c5bc;\\n    border-radius: var(--radius);\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    justify-content: center;\\n    text-align: center;\\n    background: #faf9f6;\\n}\\n\\n.coming-soon span {\\n    padding: 9px 18px;\\n    border-radius: 30px;\\n    background: var(--dark);\\n    color: white;\\n    font-size: 12px;\\n    font-weight: 600;\\n}\\n\\n.coming-soon p {\\n    margin-top: 12px;\\n    color: var(--muted);\\n    font-size: 14px;\\n}\\n\\n.why-me {\\n    max-width: none;\\n    background: #171717;\\n    color: white;\\n    padding-left: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n    padding-right: max(25px, calc((100vw - var(--max-width)) / 2 + 25px));\\n}\\n\\n.why-me .section-heading {\\n    max-width: var(--max-width);\\n    margin-left: auto;\\n    margin-right: auto;\\n}\\n\\n.why-me .section-label {\\n    color: var(--accent);\\n}\\n\\n.why-me-grid {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: 20px;\\n}\\n\\n.why-card {\\n    padding: 30px;\\n    border: 1px solid #353535;\\n    border-radius: var(--radius);\\n}\\n\\n.why-card h3 {\\n    font-size: 20px;\\n}\\n\\n.why-card p {\\n    margin-top: 12px;\\n    color: #bdbdbd;\\n    font-size: 14px;\\n    line-height: 1.7;\\n}\\n\\n.contact {\\n    text-align: center;\\n    padding-top: 130px;\\n    padding-bottom: 130px;\\n}\\n\\n.contact-content {\\n    max-width: 800px;\\n    margin: auto;\\n}\\n\\n.contact h2 {\\n    margin-top: 12px;\\n    font-family: 'Playfair Display', serif;\\n    font-size: clamp(40px, 6vw, 65px);\\n    line-height: 1.1;\\n}\\n\\n.contact-content \u003e p:not(.section-label) {\\n    max-width: 600px;\\n    margin: 20px auto 0;\\n    color: var(--muted);\\n}\\n\\n.contact-buttons {\\n    justify-content: center;\\n}\\n\\n.footer {\\n    background: #111;\\n    color: white;\\n    padding: 50px 25px 25px;\\n}\\n\\n.footer-content {\\n    max-width: var(--max-width);\\n    margin: auto;\\n    display: flex;\\n    justify-content: space-between;\\n    gap: 40px;\\n}\\n\\n.footer-brand h3 {\\n    font-family: 'Playfair Display', serif;\\n    font-size: 25px;\\n}\\n\\n.footer-brand p {\\n    margin-top: 5px;\\n    color: #999;\\n    font-size: 13px;\\n}\\n\\n.footer-links {\\n    display: flex;\\n    align-items: center;\\n    gap: 25px;\\n    flex-wrap: wrap;\\n}\\n\\n.footer-links a {\\n    color: #bbb;\\n    font-size: 13px;\\n    transition: 0.3s ease;\\n}\\n\\n.footer-links a:hover {\\n    color: white;\\n}\\n\\n.footer-bottom {\\n    max-width: var(--max-width);\\n    margin: 40px auto 0;\\n    padding-top: 20px;\\n    border-top: 1px solid #292929;\\n}\\n\\n.footer-bottom p {\\n    color: #777;\\n    font-size: 12px;\\n}\\n\\n.portfolio-card.hidden {\\n    display: none;\\n}\\n\\n@media (max-width: 900px) {\\n    .navbar {\\n        flex-wrap: wrap;\\n    }\\n\\n    .nav-links {\\n        order: 3;\\n        width: 100%;\\n        justify-content: center;\\n        gap: 20px;\\n    }\\n\\n    .hero {\\n        grid-template-columns: 1fr;\\n        padding-top: 60px;\\n    }\\n\\n    .hero-visual {\\n        justify-content: flex-start;\\n    }\\n\\n    .about-content {\\n        grid-template-columns: 1fr;\\n        gap: 45px;\\n    }\\n\\n    .services-grid,\\n    .why-me-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n\\n    .logo-grid,\\n    .poster-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n\\n    .video-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n    }\\n}\\n\\n@media (max-width: 600px) {\\n    .navbar {\\n        padding: 18px 20px;\\n    }\\n\\n    .logo img {\\n        width: 65px;\\n    }\\n\\n    .nav-button {\\n        display: none;\\n    }\\n\\n    .nav-links {\\n        gap: 15px;\\n        justify-content: flex-start;\\n        overflow-x: auto;\\n        padding-bottom: 5px;\\n    }\\n\\n    .nav-links a {\\n        white-space: nowrap;\\n        font-size: 13px;\\n    }\\n\\n    .hero {\\n        min-height: auto;\\n        padding: 65px 20px 80px;\\n        gap: 45px;\\n    }\\n\\n    .hero h1 {\\n        font-size: 48px;\\n        letter-spacing: -1px;\\n    }\\n\\n    .hero-description {\\n        font-size: 15px;\\n    }\\n\\n    .hero-card {\\n        min-height: 380px;\\n        padding: 32px;\\n    }\\n\\n    .hero-card h2 {\\n        font-size: 40px;\\n    }\\n\\n    .section {\\n        padding: 80px 20px;\\n    }\\n\\n    .section-heading {\\n        margin-bottom: 40px;\\n    }\\n\\n    .section-heading h2 {\\n        font-size: 38px;\\n    }\\n\\n    .services {\\n        padding-left: 20px;\\n        padding-right: 20px;\\n    }\\n\\n    .services-grid,\\n    .why-me-grid,\\n    .logo-grid,\\n    .poster-grid,\\n    .video-grid,\\n    .meta-ads-container {\\n        grid-template-columns: 1fr;\\n    }\\n\\n    .service-card {\\n        min-height: auto;\\n    }\\n\\n    .service-card h3 {\\n        margin-top: 35px;\\n    }\\n\\n    .portfolio-category {\\n        margin-bottom: 65px;\\n    }\\n\\n    .portfolio-filters {\\n        gap: 7px;\\n    }\\n\\n    .filter-button {\\n        padding: 8px 14px;\\n        font-size: 12px;\\n    }\\n\\n    .footer-content {\\n        flex-direction: column;\\n    }\\n\\n    .footer-links {\\n        gap: 15px;\\n    }\\n\\n    .contact {\\n        padding-top: 90px;\\n        padding-bottom: 90px;\\n    }\\n}\\n```\\n\\n### Important ra\\n\\nEe CSS **mana `index.html` ki directly match avutundi**.\\n\\nIppudu:\\n\\n1. `Ctrl + S`\\n2. `index.html` ni browser lo open cheyyi.\\n3. `images/logo.png` lo nee logo pedithe top-left lo automatic ga vastundi.\\n4. Portfolio images/videos ippudu blank ga untayi — avi manam **nee actual works upload chesthu one-by-one connect cheddam**.\\n5. `js/script.js` lo filters work avvalante next step lo JavaScript code add cheddam.\",{},{\"_273\":1856,\"_280\":1880,\"_54\":1881,\"_56\":1881,\"_284\":1882,\"_286\":287,\"_289\":290,\"_291\":1883,\"_293\":294},\"a85e0340-7451-4fd8-8f25-2637b5490087\",[1842],{\"_343\":356,\"_291\":1885},1790859078.616403,{\"_338\":339,\"_340\":1884},{\"_353\":34,\"_306\":109,\"_311\":312,\"_314\":1869,\"_316\":317,\"_318\":1870,\"_320\":1870,\"_321\":109,\"_66\":67,\"_323\":1878,\"_324\":10,\"_322\":14},[355],{},{\"_273\":1878,\"_280\":1889,\"_54\":1890,\"_56\":1891,\"_284\":1892,\"_286\":287,\"_289\":290,\"_291\":1893,\"_293\":294},\"e2e900f1-d09b-47f1-a7c5-c5fd6c23a85b\",[1856],{\"_343\":373,\"_291\":1898},1790859070.999,1790859107.838145,{\"_338\":339,\"_340\":1896},{\"_366\":1894,\"_314\":1869,\"_368\":-5,\"_318\":1870,\"_320\":1870,\"_324\":10,\"_322\":14},{\"_369\":1895},[],[1897],\"code evu direct motham\",{},{\"_273\":1887,\"_280\":1902,\"_54\":1903,\"_56\":1904,\"_284\":1905,\"_286\":287,\"_288\":34,\"_289\":290,\"_291\":1906,\"_293\":294,\"_295\":296},\"7d5983c5-4e01-4ed3-ad85-79e52d9f573b\",[1878],{\"_343\":344,\"_291\":1917},1790859058.920906,1790859062.174959,{\"_338\":339,\"_340\":1915},{\"_297\":1907,\"_299\":34,\"_300\":1908,\"_302\":1909,\"_304\":1910,\"_306\":109,\"_309\":1911,\"_311\":312,\"_313\":34,\"_314\":1912,\"_316\":317,\"_318\":1913,\"_320\":1913,\"_321\":109,\"_66\":67,\"_322\":34,\"_323\":1900,\"_324\":10},{\"_50\":334,\"_335\":1914},[],[],[],[],\"ea216add-c64e-45a1-996b-4e2792b2613c\",\"5e724402-2f61-4e37-862c-818ac300f5bb\",[337],[1916],\"Ha ra 😄. Next manam **`style.css`** build cheddam.\\n\\nFirst, `css` folder lo unna **`style.css`** open chesi, existing content unte remove chesi, manam fresh ga add cheddam.\\n\\nNenu CSS ni **sections-wise** ga istanu — Navbar → Hero → About → Services → Work → Contact → Footer → Responsive design. Ila chesthe code easy ga understand avutundi.\",{},{\"_273\":1900,\"_280\":1921,\"_54\":1922,\"_56\":1922,\"_284\":1923,\"_286\":287,\"_289\":290,\"_291\":1924,\"_293\":294},\"8e9846f1-424c-40f7-b2b9-24d7ef027f1f\",[1887],{\"_343\":356,\"_291\":1926},1790859058.889609,{\"_338\":339,\"_340\":1925},{\"_353\":34,\"_306\":109,\"_311\":312,\"_314\":1912,\"_316\":317,\"_318\":1913,\"_320\":1913,\"_321\":109,\"_66\":67,\"_323\":1919,\"_324\":10,\"_322\":14},[355],{},{\"_273\":1919,\"_280\":1930,\"_54\":1931,\"_56\":1932,\"_284\":1933,\"_286\":287,\"_289\":290,\"_291\":1934,\"_293\":294},\"9e5d8f95-f957-4c79-a9cc-62d530af31e7\",[1900],{\"_343\":373,\"_291\":1938},1790859050.225,1790859062.819466,{\"_338\":339,\"_340\":1937},{\"_366\":1935,\"_314\":1912,\"_368\":-5,\"_318\":1913,\"_320\":1913,\"_324\":10,\"_322\":14},{\"_369\":1936},[],[620],{},{\"_273\":1928,\"_280\":1942,\"_54\":1943,\"_56\":1944,\"_284\":1945,\"_286\":287,\"_288\":34,\"_289\":290,\"_291\":1946,\"_293\":294,\"_295\":296},\"f5bbe7f6-2ab2-45dd-9a69-9a6d101f55fa\",[1919],{\"_343\":344,\"_291\":1960},1790858993.541562,1790859036.894994,{\"_338\":339,\"_340\":1958},{\"_297\":1947,\"_299\":34,\"_300\":1948,\"_302\":1949,\"_304\":1950,\"_306\":109,\"_307\":1951,\"_309\":1952,\"_311\":312,\"_313\":34,\"_314\":1953,\"_316\":317,\"_318\":1954,\"_320\":1954,\"_321\":109,\"_66\":67,\"_322\":34,\"_323\":1940,\"_324\":10},{\"_50\":334,\"_335\":1957},[],[],[],{\"_325\":1955},[],\"a84496f1-6ec2-49d6-9fea-da76d510058d\",\"5943275a-a201-468b-8420-4592798d3dda\",{\"_273\":1956,\"_330\":14,\"_331\":34,\"_332\":494},\"vrxjq2\",[337],[1959],\"Yes ra. I'll remove the explanatory comments from inside the code so the file stays clean. The functionality and structure remain exactly the same.\\n\\n:::writing{variant=\\\"standard\\\" id=\\\"58321\\\" title=\\\"Clean index.html\\\"}\\n```html\\n\u003c!DOCTYPE html\u003e\\n\u003chtml lang=\\\"en\\\"\u003e\\n\\n\u003chead\u003e\\n    \u003cmeta charset=\\\"UTF-8\\\"\u003e\\n    \u003cmeta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\"\u003e\\n\\n    \u003ctitle\u003eSangeetha | Digital Marketer \u0026 Creative Freelancer\u003c/title\u003e\\n\\n    \u003clink rel=\\\"stylesheet\\\" href=\\\"css/style.css\\\"\u003e\\n\u003c/head\u003e\\n\\n\u003cbody\u003e\\n\\n    \u003cheader class=\\\"navbar\\\"\u003e\\n\\n        \u003ca href=\\\"#home\\\" class=\\\"logo\\\"\u003e\\n            \u003cimg src=\\\"images/logo.png\\\" alt=\\\"Sangeetha Logo\\\"\u003e\\n        \u003c/a\u003e\\n\\n        \u003cnav class=\\\"nav-links\\\"\u003e\\n            \u003ca href=\\\"#home\\\"\u003eHome\u003c/a\u003e\\n            \u003ca href=\\\"#about\\\"\u003eAbout\u003c/a\u003e\\n            \u003ca href=\\\"#services\\\"\u003eServices\u003c/a\u003e\\n            \u003ca href=\\\"#work\\\"\u003eMy Work\u003c/a\u003e\\n            \u003ca href=\\\"#contact\\\"\u003eContact\u003c/a\u003e\\n        \u003c/nav\u003e\\n\\n        \u003ca href=\\\"#contact\\\" class=\\\"nav-button\\\"\u003e\\n            Let's Work Together\\n        \u003c/a\u003e\\n\\n    \u003c/header\u003e\\n\\n\\n    \u003cmain\u003e\\n\\n        \u003csection id=\\\"home\\\" class=\\\"hero\\\"\u003e\\n\\n            \u003cdiv class=\\\"hero-content\\\"\u003e\\n\\n                \u003cp class=\\\"hero-small-text\\\"\u003e\\n                    Hello, I'm Sangeetha\\n                \u003c/p\u003e\\n\\n                \u003ch1\u003e\\n                    Digital Marketer\\n                    \u003cbr\u003e\\n                    \u0026 Creative Freelancer\\n                \u003c/h1\u003e\\n\\n                \u003cp class=\\\"hero-description\\\"\u003e\\n                    I help businesses build a strong digital presence\\n                    through creative design, engaging content and\\n                    digital marketing solutions.\\n                \u003c/p\u003e\\n\\n                \u003cdiv class=\\\"hero-buttons\\\"\u003e\\n\\n                    \u003ca href=\\\"#work\\\" class=\\\"primary-button\\\"\u003e\\n                        Explore My Work\\n                    \u003c/a\u003e\\n\\n                    \u003ca href=\\\"#contact\\\" class=\\\"secondary-button\\\"\u003e\\n                        Let's Work Together\\n                    \u003c/a\u003e\\n\\n                \u003c/div\u003e\\n\\n            \u003c/div\u003e\\n\\n            \u003cdiv class=\\\"hero-visual\\\"\u003e\\n\\n                \u003cdiv class=\\\"hero-card\\\"\u003e\\n\\n                    \u003cp\u003eCREATIVE\u003c/p\u003e\\n\\n                    \u003ch2\u003e\\n                        Design.\\n                        \u003cbr\u003e\\n                        Create.\\n                        \u003cbr\u003e\\n                        Grow.\\n                    \u003c/h2\u003e\\n\\n                    \u003cspan\u003e\\n                        Digital Marketing • Design • Content\\n                    \u003c/span\u003e\\n\\n                \u003c/div\u003e\\n\\n            \u003c/div\u003e\\n\\n        \u003c/section\u003e\\n\\n\\n        \u003csection id=\\\"about\\\" class=\\\"about section\\\"\u003e\\n\\n            \u003cdiv class=\\\"section-heading\\\"\u003e\\n\\n                \u003cp class=\\\"section-label\\\"\u003e\\n                    ABOUT ME\\n                \u003c/p\u003e\\n\\n                \u003ch2\u003e\\n                    The person behind the work.\\n                \u003c/h2\u003e\\n\\n            \u003c/div\u003e\\n\\n            \u003cdiv class=\\\"about-content\\\"\u003e\\n\\n                \u003cdiv class=\\\"about-text\\\"\u003e\\n\\n                    \u003cp\u003e\\n                        I'm Sangeetha, a B.Tech student and\\n                        creative freelancer with an interest in\\n                        digital marketing, design and content creation.\\n                    \u003c/p\u003e\\n\\n                    \u003cp\u003e\\n                        I started freelancing to explore new things,\\n                        develop practical skills and learn more about\\n                        the digital world.\\n                    \u003c/p\u003e\\n\\n                    \u003cp\u003e\\n                        I enjoy creating designs, editing videos,\\n                        experimenting with new ideas and continuously\\n                        learning new digital skills.\\n                    \u003c/p\u003e\\n\\n                    \u003cp\u003e\\n                        I work with businesses from different industries\\n                        and help them with their digital needs, whether\\n                        they need branding, creative content, video\\n                        editing, advertising, SEO or a website.\\n                    \u003c/p\u003e\\n\\n                \u003c/div\u003e\\n\\n                \u003cdiv class=\\\"about-highlights\\\"\u003e\\n\\n                    \u003cdiv class=\\\"highlight-card\\\"\u003e\\n                        \u003ch3\u003eCreative\u003c/h3\u003e\\n                        \u003cp\u003e\\n                            Design and content focused on\\n                            communicating ideas clearly.\\n                        \u003c/p\u003e\\n                    \u003c/div\u003e\\n\\n                    \u003cdiv class=\\\"highlight-card\\\"\u003e\\n                        \u003ch3\u003eCurious\u003c/h3\u003e\\n                        \u003cp\u003e\\n                            Always exploring new tools,\\n                            technologies and creative ideas.\\n                        \u003c/p\u003e\\n                    \u003c/div\u003e\\n\\n                    \u003cdiv class=\\\"highlight-card\\\"\u003e\\n                        \u003ch3\u003eBusiness Focused\u003c/h3\u003e\\n                        \u003cp\u003e\\n                            Creating digital solutions that\\n                            help businesses build their presence.\\n                        \u003c/p\u003e\\n                    \u003c/div\u003e\\n\\n                \u003c/div\u003e\\n\\n            \u003c/div\u003e\\n\\n        \u003c/section\u003e\\n\\n\\n        \u003csection id=\\\"services\\\" class=\\\"services section\\\"\u003e\\n\\n            \u003cdiv class=\\\"section-heading\\\"\u003e\\n\\n                \u003cp class=\\\"section-label\\\"\u003e\\n                    WHAT I DO\\n                \u003c/p\u003e\\n\\n                \u003ch2\u003e\\n                    Services I Offer\\n                \u003c/h2\u003e\\n\\n                \u003cp\u003e\\n                    Creative and digital solutions for businesses\\n                    looking to build and grow their online presence.\\n                \u003c/p\u003e\\n\\n            \u003c/div\u003e\\n\\n            \u003cdiv class=\\\"services-grid\\\"\u003e\\n\\n                \u003carticle class=\\\"service-card\\\"\u003e\\n\\n                    \u003cspan class=\\\"service-number\\\"\u003e\\n                        01\\n                    \u003c/span\u003e\\n\\n                    \u003ch3\u003e\\n                        Logo Design\\n                    \u003c/h3\u003e\\n\\n                    \u003cp\u003e\\n                        Creative logo designs that help businesses\\n                        create a recognizable visual identity.\\n                    \u003c/p\u003e\\n\\n                \u003c/article\u003e\\n\\n\\n                \u003carticle class=\\\"service-card\\\"\u003e\\n\\n                    \u003cspan class=\\\"service-number\\\"\u003e\\n                        02\\n                    \u003c/span\u003e\\n\\n                    \u003ch3\u003e\\n                        Poster \u0026 Flyer Design\\n                    \u003c/h3\u003e\\n\\n                    \u003cp\u003e\\n                        Eye-catching promotional designs for\\n                        social media, events and businesses.\\n                    \u003c/p\u003e\\n\\n                \u003c/article\u003e\\n\\n\\n                \u003carticle class=\\\"service-card\\\"\u003e\\n\\n                    \u003cspan class=\\\"service-number\\\"\u003e\\n                        03\\n                    \u003c/span\u003e\\n\\n                    \u003ch3\u003e\\n                        Video Editing\\n                    \u003c/h3\u003e\\n\\n                    \u003cp\u003e\\n                        Engaging reels, short-form videos and\\n                        promotional content for digital platforms.\\n                    \u003c/p\u003e\\n\\n                \u003c/article\u003e\\n\\n\\n                \u003carticle class=\\\"service-card\\\"\u003e\\n\\n                    \u003cspan class=\\\"service-number\\\"\u003e\\n                        04\\n                    \u003c/span\u003e\\n\\n                    \u003ch3\u003e\\n                        Meta Ads\\n                    \u003c/h3\u003e\\n\\n                    \u003cp\u003e\\n                        Instagram and Facebook advertising\\n                        campaigns designed around business goals.\\n                    \u003c/p\u003e\\n\\n                \u003c/article\u003e\\n\\n\\n                \u003carticle class=\\\"service-card\\\"\u003e\\n\\n                    \u003cspan class=\\\"service-number\\\"\u003e\\n                        05\\n                    \u003c/span\u003e\\n\\n                    \u003ch3\u003e\\n                        SEO\\n                    \u003c/h3\u003e\\n\\n                    \u003cp\u003e\\n                        Search engine optimization to help\\n                        businesses improve their online visibility.\\n                    \u003c/p\u003e\\n\\n                \u003c/article\u003e\\n\\n\\n                \u003carticle class=\\\"service-card\\\"\u003e\\n\\n                    \u003cspan class=\\\"service-number\\\"\u003e\\n                        06\\n                    \u003c/span\u003e\\n\\n                    \u003ch3\u003e\\n                        Website Design\\n                    \u003c/h3\u003e\\n\\n                    \u003cp\u003e\\n                        Clean and responsive websites designed\\n                        for businesses and personal brands.\\n                    \u003c/p\u003e\\n\\n                \u003c/article\u003e\\n\\n            \u003c/div\u003e\\n\\n        \u003c/section\u003e\\n\\n\\n        \u003csection id=\\\"work\\\" class=\\\"work section\\\"\u003e\\n\\n            \u003cdiv class=\\\"section-heading\\\"\u003e\\n\\n                \u003cp class=\\\"section-label\\\"\u003e\\n                    MY WORK\\n                \u003c/p\u003e\\n\\n                \u003ch2\u003e\\n                    Selected Creative Work\\n                \u003c/h2\u003e\\n\\n                \u003cp\u003e\\n                    A collection of my design, video editing\\n                    and digital marketing work.\\n                \u003c/p\u003e\\n\\n            \u003c/div\u003e\\n\\n            \u003cdiv class=\\\"portfolio-filters\\\"\u003e\\n\\n                \u003cbutton class=\\\"filter-button active\\\" data-filter=\\\"all\\\"\u003e\\n                    All\\n                \u003c/button\u003e\\n\\n                \u003cbutton class=\\\"filter-button\\\" data-filter=\\\"logos\\\"\u003e\\n                    Logos\\n                \u003c/button\u003e\\n\\n                \u003cbutton class=\\\"filter-button\\\" data-filter=\\\"posters\\\"\u003e\\n                    Posters\\n                \u003c/button\u003e\\n\\n                \u003cbutton class=\\\"filter-button\\\" data-filter=\\\"videos\\\"\u003e\\n                    Videos\\n                \u003c/button\u003e\\n\\n                \u003cbutton class=\\\"filter-button\\\" data-filter=\\\"meta-ads\\\"\u003e\\n                    Meta Ads\\n                \u003c/button\u003e\\n\\n                \u003cbutton class=\\\"filter-button\\\" data-filter=\\\"seo\\\"\u003e\\n                    SEO\\n                \u003c/button\u003e\\n\\n            \u003c/div\u003e\\n\\n\\n            \u003cdiv class=\\\"portfolio-category\\\"\u003e\\n\\n                \u003cdiv class=\\\"category-heading\\\"\u003e\\n\\n                    \u003ch3\u003e\\n                        Logo Design\\n                    \u003c/h3\u003e\\n\\n                    \u003cp\u003e\\n                        Brand identity and logo projects.\\n                    \u003c/p\u003e\\n\\n                \u003c/div\u003e\\n\\n                \u003cdiv class=\\\"portfolio-grid logo-grid\\\"\u003e\\n\\n                    \u003carticle class=\\\"portfolio-card logo-card\\\"\u003e\\n\\n                        \u003cdiv class=\\\"portfolio-image\\\"\u003e\\n\\n                            \u003cimg\\n                                src=\\\"\\\"\\n                                alt=\\\"Logo Design Project 01\\\"\\n                            \u003e\\n\\n                        \u003c/div\u003e\\n\\n                        \u003cdiv class=\\\"portfolio-info\\\"\u003e\\n\\n                            \u003ch4\u003e\\n                                Logo Design Project 01\\n                            \u003c/h4\u003e\\n\\n                            \u003cp\u003e\\n                                Logo Design\\n                            \u003c/p\u003e\\n\\n                        \u003c/div\u003e\\n\\n                    \u003c/article\u003e\\n\\n\\n                    \u003carticle class=\\\"portfolio-card logo-card\\\"\u003e\\n\\n                        \u003cdiv class=\\\"portfolio-image\\\"\u003e\\n\\n                            \u003cimg\\n                                src=\\\"\\\"\\n                                alt=\\\"Logo Design Project 02\\\"\\n                            \u003e\\n\\n                        \u003c/div\u003e\\n\\n                        \u003cdiv class=\\\"portfolio-info\\\"\u003e\\n\\n                            \u003ch4\u003e\\n                                Logo Design Project 02\\n                            \u003c/h4\u003e\\n\\n                            \u003cp\u003e\\n                                Logo Design\\n                            \u003c/p\u003e\\n\\n                        \u003c/div\u003e\\n\\n                    \u003c/article\u003e\\n\\n\\n                    \u003carticle class=\\\"portfolio-card logo-card\\\"\u003e\\n\\n                        \u003cdiv class=\\\"portfolio-image\\\"\u003e\\n\\n                            \u003cimg\\n                                src=\\\"\\\"\\n                                alt=\\\"Logo Design Project 03\\\"\\n                            \u003e\\n\\n                        \u003c/div\u003e\\n\\n                        \u003cdiv class=\\\"portfolio-info\\\"\u003e\\n\\n                            \u003ch4\u003e\\n                                Logo Design Project 03\\n                            \u003c/h4\u003e\\n\\n                            \u003cp\u003e\\n                                Logo Design\\n                            \u003c/p\u003e\\n\\n                        \u003c/div\u003e\\n\\n                    \u003c/article\u003e\\n\\n                \u003c/div\u003e\\n\\n            \u003c/div\u003e\\n\\n\\n            \u003cdiv cl